{
  "source": "batch_13_ai_safety_ethics_governance",
  "nodes": [
    {
      "canonical_name": "AI安全",
      "entity_type": "topic",
      "description": "研究如何降低人工智能系统失效、被攻击或产生有害行为风险的方向。"
    },
    {
      "canonical_name": "AI伦理",
      "entity_type": "topic",
      "description": "研究人工智能系统在设计、部署和使用过程中应遵循的价值与责任原则。"
    },
    {
      "canonical_name": "AI治理",
      "entity_type": "topic",
      "description": "围绕人工智能系统监管、标准、责任与风险控制建立制度和流程的方法体系。"
    },
    {
      "canonical_name": "公平性",
      "entity_type": "concept",
      "description": "模型在不同人口统计分组间表现一致、不系统性地偏向或损害特定群体的性质。"
    },
    {
      "canonical_name": "偏见",
      "entity_type": "concept",
      "description": "模型因训练数据中存在的系统性偏差而对特定群体产生不公平或不准确预测结果的社会技术问题。"
    },
    {
      "canonical_name": "可解释性",
      "entity_type": "concept",
      "description": "以人类可理解的方式揭示模型决策逻辑的能力。"
    },
    {
      "canonical_name": "可追溯性",
      "entity_type": "concept",
      "description": "能够追踪模型训练、数据来源、参数变更和决策过程的能力。"
    },
    {
      "canonical_name": "隐私保护",
      "entity_type": "topic",
      "description": "在数据采集、训练和推理过程中保护个人和敏感信息不被滥用的方法体系。"
    },
    {
      "canonical_name": "差分隐私",
      "entity_type": "method",
      "description": "通过在查询或训练中注入精确校准的随机噪声，提供数学上可证明的个体隐私保护保证。"
    },
    {
      "canonical_name": "联邦学习",
      "entity_type": "method",
      "description": "在数据不出本地前提下通过参数或梯度协同训练模型的方法。"
    },
    {
      "canonical_name": "鲁棒性",
      "entity_type": "concept",
      "description": "模型在输入扰动、噪声或分布变化下维持稳定性能的能力。"
    },
    {
      "canonical_name": "对抗攻击",
      "entity_type": "method",
      "description": "通过向输入添加人类不可察觉的微小扰动导致机器学习模型输出错误预测的攻击方法。"
    },
    {
      "canonical_name": "对抗训练",
      "entity_type": "method",
      "description": "在训练过程中动态生成对抗样本并纳入损失函数进行联合优化，使模型学会抵抗对抗扰动的鲁棒性提升方法。"
    },
    {
      "canonical_name": "价值对齐",
      "entity_type": "concept",
      "description": "使人工智能系统目标与人类意图、价值和规范保持一致的性质。"
    },
    {
      "canonical_name": "幻觉",
      "entity_type": "concept",
      "description": "生成式模型输出看似合理但事实错误或无依据内容的现象。"
    },
    {
      "canonical_name": "模型审计",
      "entity_type": "method",
      "description": "系统评估模型性能、风险、偏差、合规性和可解释性的检查过程。"
    },
    {
      "canonical_name": "风险评估",
      "entity_type": "method",
      "description": "识别、分析和分级人工智能系统潜在危害与失效场景的方法。"
    },
    {
      "canonical_name": "合规性",
      "entity_type": "concept",
      "description": "确保AI系统在数据使用和模型决策方面符合隐私法律和行业法规的制度化要求。"
    },
    {
      "canonical_name": "安全护栏",
      "entity_type": "method",
      "description": "通过规则、过滤和控制机制约束模型输出与行为边界的方法。"
    },
    {
      "canonical_name": "红队测试",
      "entity_type": "method",
      "description": "通过模拟恶意使用和极端场景主动发现人工智能系统薄弱点的测试方法。"
    }
  ],
