    },
    {
      "canonical_name": "向量数据库",
      "entity_type": "concept",
      "description": "专门存储和检索高维向量嵌入的数据库系统，通过近似最近邻搜索实现语义相似度快速匹配。"
    },
    {
      "canonical_name": "文档切分",
