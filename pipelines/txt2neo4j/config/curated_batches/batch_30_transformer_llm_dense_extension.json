  "nodes": [
    {
      "canonical_name": "编码器-解码器架构",
      "entity_type": "concept",
      "description": "由编码器负责理解输入、解码器负责逐步生成输出的经典 Transformer 架构形态。"
    },
    {
      "canonical_name": "注意力头",
      "entity_type": "concept",
      "description": "多头注意力中独立建模一种关注模式并输出子空间表示的单个注意力分支。"
    },
    {
      "canonical_name": "注意力分数",
      "entity_type": "concept",
      "description": "由查询与键之间相似度计算得到并用于后续归一化的注意力匹配分值。"
    },
    {
      "canonical_name": "注意力权重",
      "entity_type": "concept",
      "description": "对注意力分数归一化后得到的概率性权重，用于加权聚合值向量。"
    },
    {
      "canonical_name": "缩放因子",
      "entity_type": "concept",
      "description": "在缩放点积注意力中用于稳定数值范围和梯度分布的缩放项。"
    },
    {
      "canonical_name": "解码策略",
      "entity_type": "topic",
      "description": "围绕如何从模型输出分布中选择下一个词元的生成决策方法集合。"
    },
    {
      "canonical_name": "采样解码",
      "entity_type": "method",
      "description": "从候选词元概率分布中按一定随机策略抽样生成下一个词元的解码方法。"
    },
    {
      "canonical_name": "零样本提示",
      "entity_type": "method",
      "description": "不提供示例、仅依赖任务说明让模型直接完成任务的提示方法。"
    },
    {
      "canonical_name": "少样本提示",
      "entity_type": "method",
      "description": "在提示中提供少量演示样例以激发模型完成任务的上下文学习方法。"
    },
    {
      "canonical_name": "系统提示",
      "entity_type": "concept",
      "description": "用于约束模型角色、行为边界、输出格式与工具使用规则的高优先级提示部分。"
    },
    {
      "canonical_name": "偏好数据",
      "entity_type": "concept",
      "description": "记录人类对多个候选回答偏好次序或优劣判断的对齐训练数据。"
    },
    {
      "canonical_name": "预填充阶段",
      "entity_type": "concept",
      "description": "大模型先处理整段输入上下文并建立首轮隐藏状态与缓存的推理阶段。"
    },
    {
      "canonical_name": "生成阶段",
      "entity_type": "concept",
      "description": "大模型基于历史上下文和缓存逐词元递推生成输出内容的推理阶段。"
    },
    {
      "canonical_name": "首词延迟",
      "entity_type": "concept",
      "description": "从请求发起到模型生成第一个词元所经历的时间开销指标。"
    },
    {
      "canonical_name": "吞吐量",
      "entity_type": "concept",
      "description": "单位时间内模型可处理或生成的词元数量，用于衡量服务效率。"
    },
    {
      "canonical_name": "约束解码",
      "entity_type": "method",
      "description": "在生成过程中施加结构、语法或输出模式约束以保证结果满足规则的方法。"
    }
