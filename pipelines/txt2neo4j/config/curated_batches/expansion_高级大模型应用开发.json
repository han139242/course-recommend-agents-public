{
  "source": "expansion_高级大模型应用开发",
  "course_title": "高级大模型应用开发",
  "nodes": [
    {
      "canonical_name": "ReAct模式",
      "entity_type": "method",
      "description": "将推理和行动交错进行的LLM代理模式，模型生成思考轨迹决定下一步行动，从环境观察获取反馈后继续推理的迭代式问题解决方法。"
    },
    {
      "canonical_name": "思维树",
      "entity_type": "method",
      "description": "将多步推理构建为树状搜索结构，在每个节点生成多个候选思考方向，并通过搜索寻找更优推理路径的方法。"
    },
    {
      "canonical_name": "图谱推理",
      "entity_type": "method",
      "description": "将问题建模为实体关系图，利用LLM进行图上的推理链传播和实体消歧，提升多跳问答和事实验证等任务表现的方法。"
    },
    {
      "canonical_name": "多模态代理",
      "entity_type": "method",
      "description": "整合视觉、语音、文本等多模态感知和生成能力的LLM代理，能根据图像或语音指令执行复杂交互任务。"
    },
    {
      "canonical_name": "LangGraph",
      "entity_type": "framework",
      "description": "基于有向图定义LLM工作流的状态机框架，支持循环、分支和条件路由，用于构建复杂的多步代理和对话流程。"
    },
    {
      "canonical_name": "CrewAI",
      "entity_type": "framework",
      "description": "面向多Agent协作的编排框架，支持定义具有不同角色、目标和工具的Agent并组织为顺序或层次协作团队的方法。"
    },
    {
      "canonical_name": "AutoGen",
      "entity_type": "framework",
      "description": "微软开发的多Agent对话框架，支持Agent之间的代码生成、执行和纠错循环，适用于复杂编程和数据分析任务。"
    },
    {
      "canonical_name": "嵌入模型选型",
      "entity_type": "method",
      "description": "根据语义理解深度、多语言支持、序列长度和推理成本等因素，在各场景下选择最优文本嵌入模型（如BGE、E5、text-embedding系列）的方法。"
    },
    {
      "canonical_name": "语义路由",
      "entity_type": "method",
      "description": "根据用户查询的意图分类和难度评估，自动将请求路由到不同复杂度模型、不同领域知识库或不同处理流程的调度方法。"
    },
    {
      "canonical_name": "幻觉检测",
      "entity_type": "method",
      "description": "通过检索事实核查、自一致性检验、不确定性量化或多模型交叉验证等手段，识别和缓解LLM输出中不真实或矛盾内容的方法。"
    },
    {
      "canonical_name": "自一致性解码",
      "entity_type": "algorithm",
      "description": "采样多条推理路径并通过一致答案投票提高推理稳定性和准确性的解码策略。"
    },
    {
      "canonical_name": "Token级缓存匹配",
      "entity_type": "method",
      "description": "在前缀树结构中匹配已生成的Token序列，复用已有KV缓存而非重新计算来加速重复前缀和对话场景推理的优化方法。"
    },
    {
      "canonical_name": "结构化输出",
      "entity_type": "method",
      "description": "约束模型按 JSON、表格、字段或 schema 生成可机器解析结果的方法。"
    },
    {
      "canonical_name": "MCP协议",
      "entity_type": "concept",
      "description": "Model Context Protocol—Anthropic提出的LLM与外部工具和数据源之间的标准化通信协议，定义工具发现、调用和结果返回的通用接口。"
    },
    {
      "canonical_name": "A2A协议",
      "entity_type": "concept",
      "description": "Agent-to-Agent Protocol—Google提出的Agent间互操作通信协议，使不同框架构建的AI Agent能够发现彼此能力并协同完成复杂任务。"
    },
    {
      "canonical_name": "提示注入防御",
      "entity_type": "method",
      "description": "通过输入净化、指令隔离、角色锁定和输出过滤等策略，防止用户输入中的恶意提示覆盖系统指令的攻击防御方法。"
    },
    {
      "canonical_name": "成本优化策略",
      "entity_type": "method",
      "description": "通过缓存命中率提升、模型级联、自适应上下文裁剪和按需选择模型规模等手段，在保证质量前提下最小化LLM应用推理成本的方法。"
    },
    {
      "canonical_name": "延迟优化",
      "entity_type": "method",
      "description": "通过流式响应、预测性预取、连接池复用和边缘就近部署等手段，降低LLM应用端到端响应时间的多层次工程优化。"
    },
    {
      "canonical_name": "评估数据集构建",
      "entity_type": "method",
      "description": "通过人工标注、LLM生成、困难样本挖掘和多维度覆盖验证等手段，构建覆盖应用场景核心能力的高质量评测数据集的方法。"
    },
    {
      "canonical_name": "持续对齐",
      "entity_type": "method",
      "description": "将模型上线后的用户反馈、红队发现和新出现的越狱模式持续反馈到训练和微调过程中，维持和改善LLM安全对齐水平的方法。"
    }
  ],
