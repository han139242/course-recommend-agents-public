  "nodes": [
    {
      "canonical_name": "机器学习的基本概念",
      "entity_type": "topic",
      "description": "组织机器学习目标、泛化原则、损失建模与偏差方差权衡等入门核心概念的知识主题。"
    },
    {
      "canonical_name": "机器学习的分类",
      "entity_type": "topic",
      "description": "按照监督信号、数据分布与学习机制梳理机器学习主要范式的知识主题。"
    },
    {
      "canonical_name": "机械式学习",
      "entity_type": "method",
      "description": "通过直接记忆样例、规则或结论来完成问题求解的早期学习方式。"
    },
    {
      "canonical_name": "指导式学习",
      "entity_type": "method",
      "description": "依赖教师示教、标签反馈或外部指导信息进行模型学习的范式。"
    },
    {
      "canonical_name": "示例学习",
      "entity_type": "method",
      "description": "通过相似案例、样本示例或历史经验驱动泛化与预测的学习方式。"
    },
    {
      "canonical_name": "半监督学习",
      "entity_type": "method",
      "description": "联合利用少量标注数据和大量未标注数据提升模型性能的学习范式。"
    },
    {
      "canonical_name": "主动学习",
      "entity_type": "method",
      "description": "让模型主动挑选最有价值样本进行标注以降低监督成本的学习方法。"
    },
    {
      "canonical_name": "域适应",
      "entity_type": "method",
      "description": "缓解训练域与目标域分布差异以提升跨域泛化能力的迁移学习方法。"
    },
    {
      "canonical_name": "训练-验证-测试划分",
      "entity_type": "method",
      "description": "将数据集拆分为训练、调参与最终评估用途的基础实验设计方法。"
    },
    {
      "canonical_name": "留出法",
      "entity_type": "method",
      "description": "一次性划分训练集与验证集或测试集来评估模型性能的基础方法。"
    },
    {
      "canonical_name": "分层采样",
      "entity_type": "method",
      "description": "按类别或关键子群体比例分层抽样以保持数据划分代表性的方法。"
    },
    {
      "canonical_name": "数据泄漏",
      "entity_type": "concept",
      "description": "训练过程错误使用未来信息、测试信息或标签相关信息导致评估失真的问题。"
    },
    {
      "canonical_name": "类别不平衡",
      "entity_type": "concept",
      "description": "不同类别样本数量显著失衡并影响模型学习与评估稳定性的现象。"
    },
    {
      "canonical_name": "重采样",
      "entity_type": "method",
      "description": "通过对样本进行重复抽样或删减来调整训练数据分布的方法。"
    },
    {
      "canonical_name": "上采样",
      "entity_type": "method",
      "description": "增加少数类样本数量以缓解类别不平衡问题的重采样方法。"
    },
    {
      "canonical_name": "下采样",
      "entity_type": "method",
      "description": "减少多数类样本数量以提升训练平衡性的重采样方法。"
    },
    {
      "canonical_name": "代价敏感学习",
      "entity_type": "method",
      "description": "通过引入类别或错误类型代价差异来优化模型决策边界的方法。"
    },
    {
      "canonical_name": "特征缩放",
      "entity_type": "method",
      "description": "将特征值映射到相近量纲或数值范围以改善优化稳定性的方法。"
    },
    {
      "canonical_name": "Z-score标准化",
      "entity_type": "method",
      "description": "通过减均值除标准差将特征变换到零均值单位方差分布的方法。"
    },
