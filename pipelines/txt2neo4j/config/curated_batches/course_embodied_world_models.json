{
  "source": "course_embodied_world_models",
  "course_title": "具身智能与世界模型",
  "nodes": [
    {
      "canonical_name": "具身智能与世界模型",
      "entity_type": "topic",
      "description": "研究智能体在物理或仿真环境中通过感知、世界模型、规划和动作闭环完成任务的课程。"
    },
    {
      "canonical_name": "具身感知",
      "entity_type": "topic",
      "description": "围绕视觉、语言、触觉、深度和状态估计支撑具身任务理解的主题。"
    },
    {
      "canonical_name": "世界模型",
      "entity_type": "concept",
      "description": "学习环境动态性内在表示的生成模型，使智能体可以在想象中规划而无需真实环境交互。"
    },
    {
      "canonical_name": "视觉语言动作模型",
      "entity_type": "topic",
      "description": "把视觉观察、语言指令和机器人动作统一建模的具身基础模型主题。"
    },
    {
      "canonical_name": "具身策略学习",
      "entity_type": "topic",
      "description": "围绕模仿学习、强化学习、扩散策略和离线数据训练动作策略的主题。"
    },
    {
      "canonical_name": "机器人基础模型",
      "entity_type": "method",
      "description": "在多任务、多机器人或多场景数据上训练并可迁移到具身任务的基础模型。"
    },
    {
      "canonical_name": "视觉语言导航",
      "entity_type": "application",
      "description": "智能体根据自然语言指令和视觉观察在环境中导航到目标的任务。"
    },
    {
      "canonical_name": "室内具身问答",
      "entity_type": "application",
      "description": "智能体在真实或仿真空间中探索环境并回答问题的具身问答任务。"
    },
    {
      "canonical_name": "操作技能学习",
      "entity_type": "method",
      "description": "使机器人通过学习获得抓取、放置、组装等精细操作能力的综合方法。"
    },
    {
      "canonical_name": "机器人模仿学习",
      "entity_type": "method",
      "description": "从人类示范、遥操作或专家轨迹中学习机器人策略的方法。"
    },
    {
      "canonical_name": "行为克隆",
      "entity_type": "algorithm",
      "description": "使用监督学习从专家示教数据中直接学习状态到动作映射的模仿学习算法，实现简单高效但对分布偏移敏感。"
    },
    {
      "canonical_name": "逆向强化学习",
      "entity_type": "method",
      "description": "从专家示教轨迹或行为数据中反推隐含奖励函数或偏好结构，再据此训练策略的强化学习方法。"
    },
    {
      "canonical_name": "离线强化学习",
      "entity_type": "method",
      "description": "仅使用预先收集的固定数据集进行策略学习而不与环境在线交互，并通过保守估计或行为正则化控制分布外动作风险的强化学习方法。"
    },
    {
      "canonical_name": "扩散策略",
      "entity_type": "algorithm",
      "description": "将扩散模型作为机器人动作分布的生成模型，通过学习去噪过程逐步细化动作轨迹以完成连续控制任务的策略学习算法。"
    },
    {
      "canonical_name": "动作分块",
      "entity_type": "method",
      "description": "把长时序控制拆分为短动作片段以降低策略学习难度的方法。"
    },
    {
      "canonical_name": "技能库",
      "entity_type": "concept",
      "description": "可复用的低层动作技能、工具使用技能或任务子程序集合。"
    },
    {
      "canonical_name": "层级控制",
      "entity_type": "method",
      "description": "用高层任务决策和低层动作控制分层组织具身智能行为的方法。"
    },
    {
      "canonical_name": "模型预测控制",
      "entity_type": "method",
      "description": "在滚动时域内利用动态模型优化未来动作序列的控制方法。"
    },
    {
