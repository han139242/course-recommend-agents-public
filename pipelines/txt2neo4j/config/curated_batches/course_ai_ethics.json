{
  "source": "course_ai_ethics",
  "course_title": "AI伦理",
  "nodes": [
    {
      "canonical_name": "AI伦理",
      "entity_type": "topic",
      "description": "研究人工智能系统在设计、部署和使用过程中应遵循的价值与责任原则。"
    },
    {
      "canonical_name": "公平性与去偏",
      "entity_type": "topic",
      "description": "围绕算法公平、偏见来源识别与去偏技术展开的 AI 伦理主题。"
    },
    {
      "canonical_name": "可解释性方法",
      "entity_type": "topic",
      "description": "综合运用特征重要性、部分依赖图、SHAP值和反事实解释使模型决策透明化的技术体系。"
    },
    {
      "canonical_name": "隐私与隐私计算",
      "entity_type": "topic",
      "description": "围绕隐私保护、隐私攻击与隐私计算协作方法展开的主题。"
    },
    {
      "canonical_name": "对抗安全",
      "entity_type": "topic",
      "description": "围绕对抗攻击、后门威胁和鲁棒防御评测展开的安全主题。"
    },
    {
      "canonical_name": "模型安全",
      "entity_type": "topic",
      "description": "围绕大模型提示攻击、输出约束和安全防护机制展开的主题。"
    },
    {
      "canonical_name": "治理与合规",
      "entity_type": "topic",
      "description": "围绕风险分级、审计、法规遵循与治理流程展开的治理主题。"
    },
    {
      "canonical_name": "价值对齐与可信AI",
      "entity_type": "topic",
      "description": "围绕价值对齐、可信原则、人类监督和安全评测展开的主题。"
    },
    {
      "canonical_name": "公平性",
      "entity_type": "concept",
      "description": "模型在不同人口统计分组间表现一致、不系统性地偏向或损害特定群体的性质。"
    },
    {
      "canonical_name": "群体公平",
      "entity_type": "concept",
      "description": "要求模型在不同敏感群体之间保持统计意义上的相对公平表现。"
    },
    {
      "canonical_name": "个体公平",
      "entity_type": "concept",
      "description": "要求相似个体在模型决策中获得相似对待的公平原则。"
    },
    {
      "canonical_name": "机会均等",
      "entity_type": "concept",
      "description": "要求不同群体在真实正例上的被正确识别概率尽可能一致。"
    },
    {
      "canonical_name": "校准公平",
      "entity_type": "concept",
      "description": "要求不同群体在相同预测分数下具有一致真实结果概率的公平性质。"
    },
    {
      "canonical_name": "偏见来源",
      "entity_type": "concept",
      "description": "导致模型输出不公的采样、标注、特征或目标设计根源。"
    },
    {
      "canonical_name": "数据偏见",
      "entity_type": "concept",
      "description": "由样本收集、标注或覆盖不均衡导致的不公平数据问题。"
    },
    {
      "canonical_name": "算法偏见",
      "entity_type": "concept",
      "description": "由模型结构、优化目标或决策阈值引入的不公平偏差现象。"
    },
    {
      "canonical_name": "去偏方法",
      "entity_type": "method",
      "description": "用于降低模型对敏感属性依赖并改善公平指标的方法集合。"
    },
    {
      "canonical_name": "可解释性",
      "entity_type": "concept",
      "description": "以人类可理解的方式揭示模型决策逻辑的能力。"
    },
    {
      "canonical_name": "LIME",
      "entity_type": "concept",
      "description": "在局部邻域内用可解释代理模型近似复杂模型行为以获得局部解释的方法。"
    },
    {
      "canonical_name": "SHAP",
      "entity_type": "method",
      "description": "基于博弈论 Shapley 值分解特征贡献度的通用解释方法。"
    },
    {
      "canonical_name": "Grad-CAM",
      "entity_type": "method",
      "description": "利用卷积网络梯度对特征图加权并上采样得到类判别区域热图的视觉解释方法。"
    },
    {
      "canonical_name": "注意力可视化",
      "entity_type": "method",
      "description": "通过展示注意力权重分布帮助理解模型关注区域的解释方法。"
    },
    {
      "canonical_name": "概念激活向量",
      "entity_type": "concept",
      "description": "将人类可理解概念与网络内部表示方向对齐，以解释神经元群编码语义的方式。"
    },
    {
      "canonical_name": "反事实解释",
      "entity_type": "concept",
      "description": "通过构造与预测结果改变相对应的最小输入改动，说明模型决策边界附近的反事实条件。"
    },
    {
      "canonical_name": "全局解释",
      "entity_type": "concept",
      "description": "跨数据分布总结模型总体依赖模式与重要特征结构的解释类型。"
    },
    {
      "canonical_name": "局部解释",
      "entity_type": "concept",
      "description": "针对单个样本或邻域给出的细粒度解释，强调在该输入附近的模型行为。"
    },
    {
      "canonical_name": "可解释模型",
      "entity_type": "method",
      "description": "结构本身便于人类理解其决策逻辑的模型类型。"
    },
    {
      "canonical_name": "隐私保护",
      "entity_type": "topic",
      "description": "在数据采集、训练和推理过程中保护个人和敏感信息不被滥用的方法体系。"
    },
    {
      "canonical_name": "差分隐私",
      "entity_type": "method",
      "description": "通过在查询或训练中注入精确校准的随机噪声，提供数学上可证明的个体隐私保护保证。"
    },
    {
      "canonical_name": "联邦学习",
      "entity_type": "method",
      "description": "在数据不出本地前提下通过参数或梯度协同训练模型的方法。"
    },
    {
      "canonical_name": "同态加密",
      "entity_type": "method",
      "description": "允许在密文上直接执行运算而无需解密，结果解密后等价于明文计算的密码学原语。"
    },
    {
      "canonical_name": "安全多方计算",
      "entity_type": "method",
      "description": "允许多个参与方在不泄露各自私有输入前提下联合计算约定函数的密码学协议。"
    },
    {
      "canonical_name": "隐私预算",
      "entity_type": "concept",
      "description": "差分隐私框架中用于量化隐私泄露程度的控制参数。"
    },
    {
      "canonical_name": "成员推断攻击",
      "entity_type": "method",
      "description": "判断给定样本是否属于模型训练集的隐私攻击方法，可用于审计训练数据泄露风险。"
    },
    {
      "canonical_name": "模型反演攻击",
      "entity_type": "method",
      "description": "利用模型输出或中间表示逆向推断训练数据中敏感特征和样本信息的隐私攻击。"
    },
    {
      "canonical_name": "隐私计算",
      "entity_type": "topic",
      "description": "在保护数据隐私和合规前提下实现联合建模、分析与协作计算的方法体系。"
    },
    {
      "canonical_name": "匿名化",
      "entity_type": "method",
      "description": "通过脱敏和去标识化处理降低样本身份可识别性的隐私方法。"
    },
    {
      "canonical_name": "对抗攻击",
      "entity_type": "method",
      "description": "通过向输入添加人类不可察觉的微小扰动导致机器学习模型输出错误预测的攻击方法。"
    },
    {
      "canonical_name": "对抗样本",
      "entity_type": "concept",
      "description": "对人眼几乎不可辨但对模型输出产生大幅改变的刻意构造输入。"
    },
    {
      "canonical_name": "对抗训练",
      "entity_type": "method",
      "description": "在训练过程中动态生成对抗样本并纳入损失函数进行联合优化，使模型学会抵抗对抗扰动的鲁棒性提升方法。"
    },
    {
      "canonical_name": "模型鲁棒性",
      "entity_type": "concept",
      "description": "机器学习模型在面对输入扰动、分布偏移和对抗攻击时保持正确预测和稳定行为的能力。"
    },
    {
      "canonical_name": "后门攻击",
      "entity_type": "method",
      "description": "在模型训练时植入隐藏触发器，正常输入下表现正常但特定模式输入时输出预设结果的隐蔽攻击。"
    },
    {
      "canonical_name": "数据投毒",
      "entity_type": "method",
