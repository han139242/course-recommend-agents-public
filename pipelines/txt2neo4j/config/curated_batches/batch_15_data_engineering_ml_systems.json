{
  "source": "batch_15_data_engineering_ml_systems",
  "nodes": [
    {
      "canonical_name": "数据工程",
      "entity_type": "topic",
      "description": "围绕数据采集、处理、存储、流转和服务构建可靠数据基础设施的方法体系。"
    },
    {
      "canonical_name": "数据采集",
      "entity_type": "method",
      "description": "从业务系统、传感器、日志或外部来源获取训练与分析数据的方法。"
    },
    {
      "canonical_name": "数据清洗",
      "entity_type": "method",
      "description": "对缺失、异常、重复和不一致数据进行处理以提升数据质量的方法。"
    },
    {
      "canonical_name": "数据标注",
      "entity_type": "method",
      "description": "为原始数据添加类别、边界、属性或语义标签以支持监督学习的方法。"
    },
    {
      "canonical_name": "训练集",
      "entity_type": "concept",
      "description": "用于学习模型参数和模式的样本集合。"
    },
    {
      "canonical_name": "验证集",
      "entity_type": "concept",
      "description": "用于模型选择、超参数调整和早停判断的样本集合。"
    },
    {
      "canonical_name": "测试集",
      "entity_type": "concept",
      "description": "用于最终评估模型泛化性能且不参与训练和调参的样本集合。"
    },
    {
      "canonical_name": "数据管道",
      "entity_type": "method",
      "description": "对数据进行抽取、转换、加载和分发的自动化处理流程。"
    },
    {
      "canonical_name": "数据版本控制",
      "entity_type": "method",
      "description": "对数据集内容、来源和变更历史进行可追踪管理的方法。"
    },
    {
      "canonical_name": "实验跟踪",
      "entity_type": "method",
      "description": "记录模型参数、指标、代码和数据版本以支持复现实验的方法。"
    },
    {
      "canonical_name": "超参数调优",
      "entity_type": "method",
      "description": "通过系统搜索或优化策略选择更优超参数配置的方法。"
    },
    {
      "canonical_name": "特征存储",
      "entity_type": "concept",
      "description": "统一管理训练与推理阶段特征定义和服务能力的系统组件。"
    },
    {
      "canonical_name": "模型部署",
      "entity_type": "method",
      "description": "将训练完成的模型发布到生产环境提供服务的工程过程。"
    },
    {
      "canonical_name": "在线推理",
      "entity_type": "application",
      "description": "模型在请求到达时实时返回预测结果的服务方式。"
    },
    {
      "canonical_name": "离线推理",
      "entity_type": "application",
      "description": "模型以批处理方式在离线场景中统一生成预测结果的服务方式。"
    },
    {
      "canonical_name": "模型监控",
      "entity_type": "method",
      "description": "持续监测模型性能、输入分布和服务状态以发现异常的方法。"
    },
    {
      "canonical_name": "数据漂移",
      "entity_type": "concept",
      "description": "模型上线后输入数据分布相较训练阶段发生变化的现象。"
    },
    {
      "canonical_name": "概念漂移",
      "entity_type": "concept",
      "description": "输入与目标之间映射关系随时间变化导致模型失效的现象。"
    },
    {
      "canonical_name": "持续训练",
      "entity_type": "method",
      "description": "根据新数据和反馈周期性或持续更新模型的训练策略。"
    },
    {
      "canonical_name": "MLOps",
      "entity_type": "topic",
      "description": "将机器学习开发、部署、监控和运维流程工程化和自动化的方法体系。"
    }
  ],
