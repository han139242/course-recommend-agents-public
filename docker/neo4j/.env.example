# 复制为 docker/neo4j/.env 后按需修改（不要提交含生产密钥的 .env）

MYSQL_ROOT_PASSWORD=root_dev_pass
MYSQL_PASSWORD=app_dev_pass
MYSQL_HOST_PORT=3306

REDIS_HOST_PORT=6379

NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_DATABASE=neo4j

# 须足够长；与 JWT 签发一致
JWT_SECRET=local-dev-jwt-secret-change-me-please-use-32bytes-min

BACKEND_HTTP_PORT=8080
