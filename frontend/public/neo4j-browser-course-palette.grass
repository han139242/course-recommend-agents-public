node {
  diameter: 54px;
  color: #F3F4F6;
  border-color: #CBD5E1;
  border-width: 3px;
  text-color-internal: #1F2937;
  font-size: 10px;
  caption: "{canonicalName}";
}

relationship {
  color: #B8C2CF;
  shaft-width: 1.2px;
  font-size: 8px;
  padding: 3px;
  text-color-external: #475569;
  text-color-internal: #FFFFFF;
  caption: "<type>";
}

node.Competency {
  color: #DBEAFE;
  border-color: #60A5FA;
  text-color-internal: #1D4ED8;
  caption: "{name}";
}

node.FrontierDigest {
  color: #FEF3C7;
