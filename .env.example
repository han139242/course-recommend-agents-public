# 数据库配置示例 
# 团队成员使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 将下面填入我们团队共享的云数据库地址和密码
# 注意：千万不要把写了真实密码的 .env 文件提交到 git！

# ================= MySQL Configuration =================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dbuser
MYSQL_PASSWORD=dbpassword
MYSQL_DATABASE=course_recommend

# ================= Neo4j Configuration =================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword

# ================= Redis Configuration (可选) =================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
