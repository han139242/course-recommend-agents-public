APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_WRITE_TIMEOUT=2m
JWT_SECRET=course-recommend-dev-secret

# 如果复用仓库内 docker/neo4j 提供的 MySQL，请使用 app/app_dev_pass + 3307
MYSQL_DSN=app:app_dev_pass@tcp(127.0.0.1:3307)/course_recommend?parseTime=true&charset=utf8mb4&loc=Local

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password

GRAPH_WRITER_ENABLED=true
FRONTEND_DIST_DIR=web/dist

# AI proxy handled by Go backend only.
# Put your provider key in backend .env. Never expose it to the frontend.
# OpenAI-compatible configuration:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_VISION_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_ENDPOINT=
# OPENAI_VIDEO_MODEL=
# OPENAI_VIDEO_ENDPOINT=
#
# Backward-compatible DeepSeek configuration:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_VISION_MODEL=deepseek-chat
# DEEPSEEK_IMAGE_MODEL=
# DEEPSEEK_IMAGE_ENDPOINT=
# DEEPSEEK_VIDEO_MODEL=
# DEEPSEEK_VIDEO_ENDPOINT=

# Optional frontend build-time labels
# VITE_API_BASE_URL=
# VITE_API_PROXY_TARGET=http://localhost:8080
# VITE_AI_MODEL_LABEL=DeepSeek Chat (deepseek-chat)
