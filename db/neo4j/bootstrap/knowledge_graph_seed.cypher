  { source_structure_id: "816f17e699447ff5", aliases: ["多智能体系统的概念与结构"], raw_name: "多智能体系统的概念与结构", canonical_name: "多智能体系统的概念与结构", confidence: 0.9, description: "对于现实中复杂的大规模问题,只靠单个的智能体往往无法描述和解决。因此,一个应用系统中往往包含多个智能体,这些智能体不仅具备自身的问题求解能力和行为目标,而且能够相互协作,达到共同的整体目标,这样的系统称为多智能体系统(Multi-Agent System,MAS)", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "application", source_line_no: 344, name: "多智能体系统的概念与结构", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.2 多智能体系统的概念与结构", review_status: "approved", node_id: "6346698292c3d867" },
