  { source_structure_id: "cc46ac400b2fb593", aliases: ["专家系统程序设计语言"], raw_name: "专家系统程序设计语言", canonical_name: "专家系统程序设计语言", confidence: 0.95, description: "思考题207 PROLOG和LISP是两种最主要的人工智能程序设计语言 206 第7章 专家系统与机器学习 PROLOG语言是一种以逻辑推理为基础的程序设计语言。无论是它描述求解问题的方式,还是其语言本身都与一般的程序设计语言有很大的差别。它最早在20世纪70年代初由英国爱丁堡大学的R.Kowalski首先提出,1986年美国推出了TURBO PROL...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "application", source_line_no: 307, name: "专家系统程序设计语言", source_path: "人工智能导论/第7章 专家系统与机器学习/7.9 专家系统的开发工具/7.9.4 专家系统程序设计语言", review_status: "approved", node_id: "356a7830e3b7457f" },
