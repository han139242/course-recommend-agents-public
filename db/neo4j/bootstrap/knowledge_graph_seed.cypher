  { source_structure_id: "4519dd1e06be8c9a", aliases: ["翻译记忆"], raw_name: "翻译记忆", canonical_name: "翻译记忆", confidence: 0.95, description: "由于目前还没有一种机器翻译产品的效果能让人满意,因此,目前广泛采用翻译记忆(Translation Memory,TM)技术辅助专业翻译。以欧盟为例,每天都有大量的文件需要翻译成各成员国的文字,翻译工作量极大,自1997年采用德国塔多思(TRADOS)公司的翻译记忆软件以来,欧盟的翻译工作效率大大提高。如今,欧盟、国际货币基金组织等国际组织,微软、SA...", chapter_title: "自然语言处理及其应用", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 366, name: "翻译记忆", source_path: "人工智能导论/第10章 自然语言处理及其应用/10.3 机器翻译/10.3.2 翻译记忆", review_status: "approved", node_id: "8c714c82c2ea5c68" },
  { source_structure_id: "8e06ef596403fec8", aliases: ["产生式系统的例子-动物识别系统"], raw_name: "产生式系统的例子-动物识别系统", canonical_name: "产生式系统的例子-动物识别系统", confidence: 0.95, description: "下面以一个动物识别系统为例,介绍产生式系统求解问题的过程。这个动物识别系统是识别虎、金钱豹、斑马、长颈鹿、企鹅、鸵鸟、信天翁等七种动物的产生式系统 首先根据这些动物识别的专家知识,建立如下规则库 r _ { 1 } IF 该动物有毛发 THEN 该动物是哺乳动物 r _ { 2 } IF 该动物有奶 THEN 该动物是哺乳动物 r _ { 3 } IF...", chapter_title: "知识表示", facets: [], quality_issues: [], entity_type: "application", source_line_no: 168, name: "产生式系统的例子-动物识别系统", source_path: "人工智能导论/第2章 知识表示/2.3 产生式表示法/2.3.3 产生式系统的例子-动物识别系统", review_status: "approved", node_id: "8dd2c6e2624a43f1" },
  { source_structure_id: "534e7edb29fbffff", aliases: ["深度优先搜索策略"], raw_name: "深度优先搜索策略", canonical_name: "深度优先搜索策略", confidence: 0.95, description: "深度优先搜索策略是按图5.11所示的次序来搜索状态的 搜索从S。出发,沿一个方向一直扩展下去,如状态1,2,3,直到达到一定的深度(这里假定为3层)。如果未找到目的状态或无法再扩展时,便回溯到另一条路径(状态4)继续搜索;若还未找到目的状态或无法再扩展时,再回溯到另一条路径(状态5,6)搜索 S _ { 0 } ... 图5.11 深度优先搜索策略中状...", chapter_title: "搜索求解策略", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 224, name: "深度优先搜索策略", source_path: "人工智能导论/第5章 搜索求解策略/5.3 盲目的图搜索策略/5.3.3 深度优先搜索策略", review_status: "approved", node_id: "8df8da637847ae14" },
