  { source_structure_id: "92aa955667d92cac", aliases: ["蚁群算法及其应用"], raw_name: "蚁群算法及其应用", canonical_name: "蚁群算法及其应用", confidence: 0.9, description: "蚁群算法(Ant Colony Optimization,ACO)是由意大利科学家Marco Dorigo等受蚂蚁觅食行为的启发,在20世纪90年代初提出来的。它是继模拟退火算法、遗传算法、禁忌搜索算法、人工神经网络算法等启发式搜索算法后的又一种应用于组合优化问题的启发式搜索算法。研究表明,蚁群优化算法在解决离散组合优化方面具有良好的性能,并在多方面得...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 260, name: "蚁群算法及其应用", source_path: "人工智能导论/第6章 智能计算及其应用/6.7 蚁群算法及其应用", review_status: "approved", node_id: "b036a204600191fd" },
  { source_structure_id: "72f742b0d63286dc", aliases: ["多智能体系统的协作"], raw_name: "多智能体系统的协作", canonical_name: "多智能体系统的协作", confidence: 0.9, description: "建立多智能体系统的目的在于解决由单一智能体难以处理的复杂问题,即任务在时间或空间上的复杂性超过了单个智能体的能力,仅仅依靠单个智能体行为来实现是不可能、不经济、不完整的,因此协作行为就成为多智能体系统必不可少的行为。在多智能体系统中,智能体之间的协调和合作是研究的核心问题之一,也是衡量系统智能水平的重要指标 致的局部目标 3自私型。系统中不存在共同的全...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "application", source_line_no: 353, name: "多智能体系统的协作", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.5 多智能体系统的协作", review_status: "approved", node_id: "b0378386d4468f11" },
