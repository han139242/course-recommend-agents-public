  { source_structure_id: "6f5d97273632cafc", aliases: ["自然演绎推理"], raw_name: "自然演绎推理", canonical_name: "自然演绎推理", confidence: 0.9, description: "从一组已知为真的事实出发,直接运用经典逻辑的推理规则推出结论的过程称为自然演绎推理。其中,基本的推理是P规则、T规则、假言推理、拒取式推理等 假言推理的一般形式是 P,P \\rightarrow Q \\Rightarrow Q 它表示:由P \\rightarrow Q及P为真,可推出Q为真 例如,由“如果x是金属,则x能导电”及“铜是金属”可推出“铜能...", chapter_title: "确定性推理方法", facets: [], quality_issues: [], entity_type: "method", source_line_no: 183, name: "自然演绎推理", source_path: "人工智能导论/第3章 确定性推理方法/3.2 自然演绎推理", review_status: "approved", node_id: "eadee55ee83bf5e2" },
