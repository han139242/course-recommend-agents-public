  { source_structure_id: "6274b409ea55aef3", aliases: ["慎思式Agent"], raw_name: "慎思式Agent", canonical_name: "慎思式Agent", confidence: 0.95, description: "慎思式Agent是一种基于知识的系统,包括环境描述和丰富的智能行为的逻辑推理能力。慎思式Agent结构示意图如图9.3所示,Agent接收的外部环境信息,依据内部状态进行信息融合,以产生修改当前状态的描述。然后,在知识库的支持下制订规划,再在目标指引下形成动作序列,对环境进行作用 Agent 目标 知识库 状态 作用决策 规划 信息融合 执行器 环境 ...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 7297, name: "慎思式Agent", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.1 智能体的概念与结构/9.1.5 慎思式Agent", review_status: "approved", node_id: "75be5a814e396149" },
