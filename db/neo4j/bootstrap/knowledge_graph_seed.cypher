  { source_structure_id: "294bfc71c8fb1eba", aliases: ["模糊关系与模糊关系的合成"], raw_name: "模糊关系与模糊关系的合成", canonical_name: "模糊关系与模糊关系的合成", confidence: 0.95, description: "1.模糊关系 在模糊集合论中,模糊关系占有重要地位。模糊关系是普通关系的推广。普通关系是描述两个集合中的元素之间是否有关联。模糊关系描述两个模糊集合中的元素之间的关联程度。当论域为有限时,可以采用模糊矩阵表示模糊关系 例4.6 某地区人的身高论域X={140,150,160,170,180}(单位:cm),体重论域Y = \\{ 4 0 , 5 0,60...", chapter_title: "不确定性推理方法", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 207, name: "模糊关系与模糊关系的合成", source_path: "人工智能导论/第4章 不确定性推理方法/4.4 模糊推理方法/4.4.4 模糊关系与模糊关系的合成", review_status: "approved", node_id: "a7908714679f2455" },
