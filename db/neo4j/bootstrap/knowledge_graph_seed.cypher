  { source_structure_id: "80c8221db61e8162", aliases: ["市场机制协作方法"], raw_name: "市场机制协作方法", canonical_name: "市场机制协作方法", confidence: 0.95, description: "上述两种智能体协作机制要求智能体之间直接通信,一般适合数量较小的智能体之间的协作求解,对于异构环境下的大量智能体之间的协作,市场机制则是较好的解决方案 20世纪90年代末期,电子商务和虚拟企业等复杂系统的发展,迫切需要研究异构智能体如", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "method", source_line_no: 357, name: "市场机制协作方法", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.5 多智能体系统的协作/9.5.4 市场机制协作方法", review_status: "approved", node_id: "5f6c76ec066a2ba2" },
