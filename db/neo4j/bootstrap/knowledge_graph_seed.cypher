  { source_structure_id: "6d829394ae31ae68", aliases: ["双倍体遗传算法"], raw_name: "双倍体遗传算法", canonical_name: "双倍体遗传算法", confidence: 0.95, description: "1.基本思想 Holland提出的遗传算法通常被称作基本遗传算法(Simple Genetic Algorithms,SGA)。SGA是一种“单倍体遗传”,每个基因型由一条染色体组成。自然界中一些简单的植物采用这种遗传,而大多数动物和高级植物都采用双倍体遗传,即每个基因型由一对染色体组成 146 第6章 智能计算及其应用 双倍体遗传算法(Double ...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 250, name: "双倍体遗传算法", source_path: "人工智能导论/第6章 智能计算及其应用/6.3 遗传算法的改进算法/6.3.1 双倍体遗传算法", review_status: "approved", node_id: "48c53d8d75bf434a" },
  { source_structure_id: "7147c30ecdf89d83", aliases: ["机器学习"], raw_name: "机器学习", canonical_name: "机器学习", confidence: 0.9, chapter_title: "专家系统与机器学习", description: "机器学习是人工智能中一个重要的研究领域,一直受到人工智能及认知心理学家们的普遍关注。关于机器学习的研究,可以追溯到20世纪50年代中期。当时人们从仿生学的角度开展了研究,希望搞清楚人类大脑及神经系统的学习机理。但由于受到客观条件的限制,未能如愿。之后几经波折,直到20世纪80年代才获得了蓬勃发展 近年来,随着专家系统的发展,需要系统具有学习能力,这促进...", facets: [], quality_issues: [], source_line_no: 287, entity_type: "topic", name: "机器学习", source_path: "人工智能导论/第7章 专家系统与机器学习/7.5 机器学习", review_status: "approved", node_id: "493d1797dc4ecf08" },
  { source_structure_id: "curated::机器人定位", aliases: ["机器人定位"], raw_name: "机器人定位", canonical_name: "机器人定位", confidence: 1, description: "估计机器人在已知或部分已知环境中自身位置的过程。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "机器人定位", source_path: "curated/batch_12_robotics_embodied_ai_foundation", review_status: "approved", node_id: "49fd296a85b650de" },
  { source_structure_id: "8e6d3f3094c925ff", aliases: ["谓词公式", "谓词公式的性质"], raw_name: "谓词公式", canonical_name: "谓词公式", confidence: 0.95, description: "无论是命题逻辑还是谓词逻辑,均可用下列连接词把一些简单命题连接起来构成一个复合命题,以表示一个比较复杂的含义 1.连接词(连词) 1:称为“否定”(Negation)或者“非”。它表示否定位于它后面的命题。当命题P为真时,P为假;当P为假时,P为真 例如,“机器人不在2号房间内”,表示为 へI N R O O M ( R o b o t , R 2 )...", chapter_title: "知识表示", facets: ["性质"], quality_issues: ["facet_merged"], entity_type: "concept", source_line_no: 161, name: "谓词公式", source_path: "人工智能导论/第2章 知识表示/2.2 一阶谓词逻辑表示法/2.2.3 谓词公式", review_status: "approved", node_id: "4b83593baa0bcdd6" },
