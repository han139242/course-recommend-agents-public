  { source_structure_id: "d528a1acdf0420eb", aliases: ["连续型Hopfield神经网络及其VLSI实现"], raw_name: "连续型Hopfield神经网络及其VLSI实现", canonical_name: "连续型Hopfield神经网络及其VLSI实现", confidence: 0.95, description: "离散型Hopfield神经网络中的神经元与生物神经元的差别较大,因为生物神经元的输入与输出是连续的,而且生物神经元存在时滞。1984年,Hopfield 又提出一种连续时间神经网络模型,在这种网络中,神经元的状态可以取0至1之间的任一实数值 连续型Hopfield神经网络的电子线路实现如图8.10所示 I _ { 1 } I _ { 2 } I _ {...", chapter_title: "人工神经网络及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 325, name: "连续型Hopfield神经网络及其VLSI实现", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.4 Hopfield神经网络及其改进/8.4.2 连续型Hopfield神经网络及其VLSI实现", review_status: "approved", node_id: "70d22e44382dc8fe" },
  { source_structure_id: "5bd2bc9e35f3815d", aliases: ["知识发现的一般过程"], raw_name: "知识发现的一般过程", canonical_name: "知识发现的一般过程", confidence: 0.95, description: "知识发现过程可粗略地划分为数据准备、数据挖掘以及结果的解释和评价等三步 1.数据准备 数据准备又可分为三个子步骤:数据选取、数据预处理和数据变换。数据选取就是确定目标数据,即操作对象,它是根据用户的需要从原始数据库中抽取的一组数据。数据预处理一般可能包括消除噪声、推导计算缺值数据、消除重复记录、完成数据类型转换等。当数据开采的对象是数据仓库时,一般来说...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 295, name: "知识发现的一般过程", source_path: "人工智能导论/第7章 专家系统与机器学习/7.6 知识发现与数据挖掘/7.6.2 知识发现的一般过程", review_status: "approved", node_id: "70ddd0b5b9957b5d" },
