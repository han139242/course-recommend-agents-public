  { source_structure_id: "ff044e7746f478ce", aliases: ["人工智能"], raw_name: "人工智能", canonical_name: "人工智能", confidence: 0.95, chapter_title: "绪论", description: "所谓人工智能就是用人工的方法在机器(计算机)上实现的智能,也称为机器智能(MachineIntelligence) 关于“人工智能”的含义,早在它被正式提出之前,就由英国数学家图灵(A.M.Turing)提出了。1950年他发表了题为《计算机与智能(Computing Machinery and Intelligence)》的论文,文章以“机器能思维吗...", facets: [], quality_issues: [], source_line_no: 144, entity_type: "topic", name: "人工智能", source_path: "人工智能导论/第1章 绪论/1.1 人工智能的基本概念/1.1.3 人工智能", review_status: "approved", node_id: "ad12a7f5471d546d" },
  { source_structure_id: "6c46c636edba1618", aliases: ["知识获取的主要过程与模式"], raw_name: "知识获取的主要过程与模式", canonical_name: "知识获取的主要过程与模式", confidence: 0.9, description: "知识获取通常是由知识工程师与专家系统中的知识获取机构共同完成的。知识工程师负责从领域专家那里抽取知识,并用适合的方法把知识表达出来。知识获取机构把知识转换为计算机可存储的内部形式,然后把它们存入知识库。在存储过程中,要对知识进行一致性、完整性的检测 不同专家系统的知识获取功能与实现方法差别较大,有的系统采用自动获取知识的方法,而有的系统则采用非自动或半...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 284, name: "知识获取的主要过程与模式", source_path: "人工智能导论/第7章 专家系统与机器学习/7.4 知识获取的主要过程与模式", review_status: "approved", node_id: "ad650f016b83970b" },
  { source_structure_id: "curated::偏导数", aliases: ["偏导数"], raw_name: "偏导数", canonical_name: "偏导数", confidence: 1, description: "多元函数对某一变量单独变化率的度量。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 0, name: "偏导数", source_path: "curated/batch_14_ai_math_optimization_foundation", review_status: "approved", node_id: "ad9b7c8ab0164d98" },
  { source_structure_id: "e9c77a6073c05504", aliases: ["进化算法的生物学背景"], raw_name: "进化算法的生物学背景", canonical_name: "进化算法的生物学背景", confidence: 0.95, description: "进化算法类似于生物进化,需要经过长时间的成长演化,最后收敛到最优化问题的一个或者多个解。因此,了解一些生物进化过程,有助于理解遗传算法的工作过程 “适者生存”揭示了大自然生物进化过程中的一个规律:最适合自然环境的群体往往产生了更大的后代群体。生物进化的基本过程如图6.1所示 群体 变异 子群 婚配 竞争 淘汰的 种群 群体 图6.1 生物进化的基本过程...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 236, name: "进化算法的生物学背景", source_path: "人工智能导论/第6章 智能计算及其应用/6.1 进化算法的产生与发展/6.1.2 进化算法的生物学背景", review_status: "approved", node_id: "addb611e6990aa00" },
