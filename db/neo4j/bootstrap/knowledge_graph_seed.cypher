  { source_structure_id: "9056544deff895a8", aliases: ["反应式Agent"], raw_name: "反应式Agent", canonical_name: "反应式Agent", confidence: 0.95, description: "反应式Agent是一种具备对当时处境的实时反应能力的Agent。图9.2为反应式Agent的结构示意图 图9.2中,Agent的If-then规则使Agent将感知和动作连接起来。反应式Agent内部预置了相关的知识,包含了行为集和约束关系。在外界刺激符合一定的条件后,直接调用预置的知识,产生相应的输出。每个Agent既是客户又是服务器,根据程序提出请...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 340, name: "反应式Agent", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.1 智能体的概念与结构/9.1.4 反应式Agent", review_status: "approved", node_id: "1ffc5162a24c36c3" },
