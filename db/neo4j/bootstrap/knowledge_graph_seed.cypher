  { source_structure_id: "curated::支持向量机", aliases: ["支持向量机"], raw_name: "支持向量机", canonical_name: "支持向量机", confidence: 1, description: "通过最大间隔超平面进行分类或回归的经典学习算法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 0, name: "支持向量机", source_path: "curated/curated_ai_professional_ontology", review_status: "approved", node_id: "95ecb830a2fd3bcf" },
  { source_structure_id: "04e6c9b1219062e7", aliases: ["多智能体系统的协商"], raw_name: "多智能体系统的协商", canonical_name: "多智能体系统的协商", confidence: 0.9, description: "思考题259 何自主地实现协作的问题。这里的异构智能体可能是由不同的人,在不同的时间,利用不同的软件工具、技术,实现从属于不同组织的智能体。这些应用需求导致新的协作技术的出现 市场机制的基本思想是针对分布式资源分配的待定问题,建立相应的计算经济,使智能体之间通过最少的直接通信来协调多个智能体之间的活动。在该方法中,对智能体关心的所有事务(如技能、资源等...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "application", source_line_no: 358, name: "多智能体系统的协商", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.6 多智能体系统的协商", review_status: "approved", node_id: "9601c8f562e0a596" },
