  { source_structure_id: "9202021fe9bbb7e9", raw_name: "多智能体系统的特点", aliases: ["多智能体系统", "多智能体系统的特点"], canonical_name: "多智能体系统", confidence: 0.95, description: "1MAS中每个智能体具有独立性和自主性,能够解决给定的子问题,自主地推理和规划并选择恰当的策略,并以特定的方式影响周围的环境 2MAS支持分布式应用,具有良好的模块性,易于扩展,设计简单灵活,克服了建造大规模知识库时的知识管理和扩展的困难 3MAS按面向对象的方法构造多层次、多元化的智能体,降低了系统的复杂性,也降低了各个智能体问题求解的复杂性 4MA...", chapter_title: "智能体与多智能体系统", facets: ["特点"], quality_issues: ["facet_merged"], source_line_no: 345, entity_type: "topic", name: "多智能体系统", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.2 多智能体系统的概念与结构/9.2.1 多智能体系统的特点", review_status: "approved", node_id: "6a735b0fe4ec2cc1" },
