  { source_structure_id: "curated::机器人感知", aliases: ["机器人感知"], raw_name: "机器人感知", canonical_name: "机器人感知", confidence: 1, description: "利用传感器获取并理解环境、目标和自身状态信息的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "机器人感知", source_path: "curated/batch_12_robotics_embodied_ai_foundation", review_status: "approved", node_id: "98fb33ea1d0a923f" },
  { source_structure_id: "9589c6cc8315450e", aliases: ["BP神经网络在软测量中", "BP神经网络在软测量中的应用"], raw_name: "BP神经网络在软测量中的应用", canonical_name: "BP神经网络在软测量中", confidence: 0.95, description: "1.软测量技术 在工业过程中,为了保证产品的质量和生产的连续平稳,需要对与品质密切相关的过程变量进行实时监控,然而常常存在一些重要的变量无法或难以用传感器直接检测。例如,化学反应器的产品质量、发酵罐的菌体浓度等都是很难在线测量的。有时,这类变量可以采用在线分析仪直接测量,但需要很大的设备投资,并且会有很大的滞后。对于这类变量可以采用软测量方法进行间接测...", chapter_title: "人工神经网络及其应用", facets: ["应用"], quality_issues: ["facet_merged"], entity_type: "algorithm", source_line_no: 322, name: "BP神经网络在软测量中", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.3 BP神经网络的应用/8.3.2 BP神经网络在软测量中的应用", review_status: "approved", node_id: "9916fb5a50a9a78f" },
  { source_structure_id: "82bace8fb445923a", aliases: ["人工智能的基本概念"], raw_name: "人工智能的基本概念", canonical_name: "人工智能的基本概念", confidence: 0.9, description: "到的外部信息以及由思维所产生的知识;思维用于对记忆的信息进行处理,即利用已有的知识对信息进行分析、计算、比较、判断、推理、联想及决策等。思维是一个动态过程,是获取知识以及运用知识求解问题的根本途径 思维可分为逻辑思维、形象思维以及顿悟思维等 (1)逻辑思维 逻辑思维又称为抽象思维。它是一种根据逻辑规则对信息进行处理的理性思维方式。人们首先通过感觉器官获...", chapter_title: "绪论", facets: [], quality_issues: [], source_line_no: 141, entity_type: "topic", name: "人工智能的基本概念", source_path: "人工智能导论/第1章 绪论/1.1 人工智能的基本概念", review_status: "approved", node_id: "9931eb6100493921" },
  { source_structure_id: "179ca2cb69ce5a62", aliases: ["复合式Agent"], raw_name: "复合式Agent", canonical_name: "复合式Agent", confidence: 0.95, description: "复合式Agent综合了反应式Agent和慎思式Agent的优点,具有较强的灵活性和快速的响应性。复合式Agent是在一个Agent内组合多种相对独立和并行执行的智能形态,其结构包括感知、动作、反应、建模、规划、通信和决策等模块,如图9.4所示 Agent通过感知模块来感知外部环境信息,再送到不同的处理模块。若感知紧急和简单情", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 7311, name: "复合式Agent", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.1 智能体的概念与结构/9.1.6 复合式Agent", review_status: "approved", node_id: "9933f78ccb9a976f" },
