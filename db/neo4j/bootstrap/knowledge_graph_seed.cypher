  { source_structure_id: "88b06be32c567a39", aliases: ["进化算法的设计原则"], raw_name: "进化算法的设计原则", canonical_name: "进化算法的设计原则", confidence: 0.95, description: "一般来说,进化算法的求解包括以下几个步骤:给定一组初始解;评价当前这组解的性能;从当前这组解中选择一定数量的解作为迭代后的解的基础;再对其进行操作,得到迭代后的解;若这些解满足要求则停止,否则将这些迭代得到的解作为当前解重新操作 设计进化算法的基本原则如下 (1)适用性原则:一个算法的适用性是指该算法所能适用的问题种类,它取决于算法所需的限制与假定。优...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 237, name: "进化算法的设计原则", source_path: "人工智能导论/第6章 智能计算及其应用/6.1 进化算法的产生与发展/6.1.3 进化算法的设计原则", review_status: "approved", node_id: "53ddf2fb1c97260d" },
