  { source_structure_id: "4a8361ec08eaf5e1", aliases: ["游戏人工智能的概念与分类"], raw_name: "游戏人工智能的概念与分类", canonical_name: "游戏人工智能的概念与分类", confidence: 0.95, description: "适合于游戏开发的人工智能技术称为游戏人工智能(Game AI) 与一般的人工智能技术不同,游戏人工智能算法不一定要满足通用性,只要能够使角色的行为在某些场合内合理就行了。实际上,即使出现了一些人工智能错误,只要不是很明显,而且不降低游戏的娱乐性,玩家不会太在乎,甚至给玩家带来意想不到的兴奋。而对于医疗诊断等专家系统,这些错误就不能存在了 游戏人工智能分...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 377, name: "游戏人工智能的概念与分类", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.2 游戏人工智能/11.2.1 游戏人工智能的概念与分类", review_status: "approved", node_id: "7a622f7a0f8f67cf" },
