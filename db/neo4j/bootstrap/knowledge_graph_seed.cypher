  { source_structure_id: "a552f6c8bfe9d603", aliases: ["游戏角色的路径搜索"], raw_name: "游戏角色的路径搜索", canonical_name: "游戏角色的路径搜索", confidence: 0.95, description: "路径搜索是智能游戏软件中最基本的问题之一。有效的路径搜索方法可以让角色看起来很真实,使游戏变得更有趣味性 在简单的情况下,有以下几种路径搜索算法 1在不考虑躲避障碍物的情况下,路径搜索算法即为追逐算法 2若考虑躲避障碍物,则随机移动;如果直线上没有障碍物,则沿直线向目标移动。这种方法在开阔的场景,且障碍物数量较少、体积较小的情况下(如只有少量的树木)是...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 384, name: "游戏角色的路径搜索", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.4 智能游戏角色设计基本技术/11.4.4 游戏角色的路径搜索", review_status: "approved", node_id: "df73ed84d5717814" },
