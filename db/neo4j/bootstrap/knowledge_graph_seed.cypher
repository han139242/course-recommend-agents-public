  { source_structure_id: "d5dc106cf44640a4", aliases: ["智能体的结构"], raw_name: "智能体的结构", canonical_name: "智能体的结构", confidence: 0.95, description: "Agent结构接受传感器的输入,然后运行Agent程序,并把执行的结果传送到效应器进行动作。Agent系统的结构直接影响到系统的性能。人工智能的任务就是设计Agent程序,实现Agent从感知到动作的映射函数。这种Agent程序需要在某种称为结构的计算机设备上运行。简单的Agent结构可能只是一台计算机,复杂的Agent结构可能包括用在特定任务上的特殊...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], source_line_no: 339, entity_type: "topic", name: "智能体的结构", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.1 智能体的概念与结构/9.1.3 智能体的结构", review_status: "approved", node_id: "91841e1f11b1d9d5" },
  { source_structure_id: "effaa4f12d24fed5", aliases: ["多智能体系统的基本类型"], raw_name: "多智能体系统的基本类型", canonical_name: "多智能体系统的基本类型", confidence: 0.95, description: "针对不同的应用环境,从不同角度提出了多种类型的多智能体模型,包括BDI模型、协商模型、协作规划模型和自协调模型等 1.BDI模型 BDI模型是一个概念和逻辑上的理论模型,是研究Agent理性和推理机制的基础。在把BDI模型扩展到MAS的研究时,提出了联合意图、社会承诺、合理行为等Agent行为的形式化定义。联合意图为Agent建立复杂动态环境下的协作框...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "application", source_line_no: 346, name: "多智能体系统的基本类型", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.2 多智能体系统的概念与结构/9.2.2 多智能体系统的基本类型", review_status: "approved", node_id: "91cf62aab66f5b79" },
  { source_structure_id: "curated::消融实验", aliases: ["消融实验"], raw_name: "消融实验", canonical_name: "消融实验", confidence: 1, description: "通过逐项移除或替换模型组件以量化其对性能贡献的受控对比实验。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "消融实验", source_path: "curated/batch_25_ai_evaluation_benchmark_experiment_design", review_status: "approved", node_id: "91f8c64b42e5daf8" },
  { source_structure_id: "curated::人类反馈强化学习", aliases: ["人类反馈强化学习"], raw_name: "人类反馈强化学习", canonical_name: "人类反馈强化学习", confidence: 1, description: "利用人类偏好反馈优化生成模型行为和输出质量的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], source_line_no: 0, entity_type: "method", name: "人类反馈强化学习", source_path: "curated/batch_10_generative_ai_foundation", review_status: "approved", node_id: "924eba3ff0ad6559" },
  { source_structure_id: "curated::逻辑神经网络", aliases: ["逻辑神经网络"], raw_name: "逻辑神经网络", canonical_name: "逻辑神经网络", confidence: 1, description: "将逻辑约束、可微松弛或神经模块嵌入到网络结构中以实现可学习推理的建模范式。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "逻辑神经网络", source_path: "curated/batch_27_neurosymbolic_program_synthesis", review_status: "approved", node_id: "93b757b4da315140" },
  { source_structure_id: "141b04252af5889f", raw_name: "智能体的概念与结构", aliases: ["Agent的应用", "智能体", "智能体的概念", "智能体的概念与结构", "智能体的特性"], canonical_name: "智能体", confidence: 0.95, description: "智能体(Agent)技术是当前人工智能研究的热点之一。Agent在英语中是个多义词,国内学术界将Agent翻译为“主体”、“智能体”、“智能代理”等,尚无统一的译法。本章将Agent 翻译为“智能体”,或者直接引用英文 在人工智能领域中,Agent可以看作是一个程序或者一个实体,它嵌入在环境中,通过传感器(sensor)感知环境,通过效应器(effec...", chapter_title: "智能体与多智能体系统", facets: ["应用", "概念", "特性"], quality_issues: ["facet_merged"], source_line_no: 334, entity_type: "topic", name: "智能体", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.1 智能体的概念与结构", review_status: "approved", node_id: "94e6c8ee10faf9cd" },
  { source_structure_id: "curated::top-k采样", aliases: ["top-k采样"], raw_name: "top-k采样", canonical_name: "top-k采样", confidence: 1, description: "仅在概率最高的前 k 个候选中进行随机采样的解码方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "top-k采样", source_path: "curated/batch_10_generative_ai_foundation", review_status: "approved", node_id: "94eb4aad6cb3549a" },
  { source_structure_id: "curated::状态价值函数", aliases: ["状态价值函数"], raw_name: "状态价值函数", canonical_name: "状态价值函数", confidence: 1, description: "衡量在给定策略下从某状态开始能获得期望回报的函数。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 0, name: "状态价值函数", source_path: "curated/batch_09_reinforcement_learning_foundation", review_status: "approved", node_id: "9592965af2607fe2" },
  { source_structure_id: "173238f0abb8a870", aliases: ["盲目的图搜索策略"], raw_name: "盲目的图搜索策略", canonical_name: "盲目的图搜索策略", confidence: 0.9, description: "多条路径才能找到目的状态。一个搜索算法的策略就是要决定树或图中状态的搜索次序。回溯策略是一种系统地尝试状态空间中各种不同路径的技术 回溯策略的搜索是从初始状态出发,不停地、试探性地寻找路径,直到到达目的或“不可解结点”,即“死胡同”为止。回溯策略是当遇到不可解结点时就回溯到路径中最近的父结点上,查看该结点是否还有其他的子结点未被扩展。若有,则沿这些子结...", chapter_title: "搜索求解策略", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 221, name: "盲目的图搜索策略", source_path: "人工智能导论/第5章 搜索求解策略/5.3 盲目的图搜索策略", review_status: "approved", node_id: "95a55fa1374b61ed" },
