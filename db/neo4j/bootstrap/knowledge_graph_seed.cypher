  { source_structure_id: "025b506e45d24db6", aliases: ["专家系统的工作原理知识库", "知识库"], raw_name: "知识库", canonical_name: "专家系统的工作原理知识库", confidence: 0.95, description: "知识库(Knowledge Base)主要用来存放领域专家提供的有关问题求解的专门知识。知识库中的知识来源于知识获取机构,同时它又为推理机提供求解问题所需的知识 1.知识表示方法的选择 要建立知识库,首先要选择合适的知识表达方法。对同一知识,一般都可以用多种方法进行表示,但其效果却不同。应根据选择知识表达方法,即从能充分表示领域知识、能充分有效地进行推...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "method", source_line_no: 278, name: "专家系统的工作原理知识库", source_path: "人工智能导论/第7章 专家系统与机器学习/7.3 专家系统的工作原理/7.3.2 知识库", review_status: "approved", node_id: "a53f6169974affea" },
  { source_structure_id: "817e92cd01379e6e", aliases: ["黑板模型协作方法"], raw_name: "黑板模型协作方法", canonical_name: "黑板模型协作方法", confidence: 0.95, description: "黑板的概念最早是由Newell提出的。黑板模型的基本思想为:多个人类专家或智能体专家协同求解一个问题,黑板是一个共享的问题求解工作空间,多个专家都能“看到”黑板。当问题和初始数据记录到黑板上,求解开始。所有专家通过“看”黑板寻找利用其专家经验知识求解问题的机会。当一个专家发现黑板上的信息足以支持他进一步求解问题时,他就将求解结果记录在黑板上。新增加的信...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "method", source_line_no: 356, name: "黑板模型协作方法", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.5 多智能体系统的协作/9.5.3 黑板模型协作方法", review_status: "approved", node_id: "a5849382c4c6d2ff" },
