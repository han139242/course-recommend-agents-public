  { source_structure_id: "curated::矩阵乘法", aliases: ["矩阵乘法"], raw_name: "矩阵乘法", canonical_name: "矩阵乘法", confidence: 1, description: "用于组合线性变换和执行特征映射计算的基本矩阵运算。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 0, name: "矩阵乘法", source_path: "curated/batch_14_ai_math_optimization_foundation", review_status: "approved", node_id: "7c770c128dd30ab9" },
  { source_structure_id: "9dabff4358d00e72", aliases: ["Agent通信的方式"], raw_name: "Agent通信的方式", canonical_name: "Agent通信的方式", confidence: 0.95, description: "Agent之间的通信是多智能体系统的基本功能。通信可分为黑板系统和消息/对话系统两种方式 250 第9章 智能体与多智能体系统 1.黑板系统 黑板系统主要支持分布式问题求解。在多智能体系统中,黑板提供公共工作区,参与求解的Agent可以“看”到黑板上的问题、数据、求解记录,并将自己对问题的求解结果“写”到黑板上,以供其他Agent进行参考、求解。在这一...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 350, name: "Agent通信的方式", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.3 多智能体系统的通信/9.3.2 Agent通信的方式", review_status: "approved", node_id: "7c94a6e91ddd3032" },
  { source_structure_id: "4389f7ce0beacf9c", aliases: ["BP神经网络的结构"], raw_name: "BP神经网络的结构", canonical_name: "BP神经网络的结构", confidence: 0.95, description: "BP神经网络(Back-Propagation Neural Network)就是多层前向网络,其结构如图8.3所示 m-1 ... .. ... ... + 1 + 1 + 1 输入层 隐层 输出层 图8.3 BP神经网络结构 设BP神经网络具有m层。第一层称为输入层,最后一层称为输出层,中间各层称为隐层。标上“+1”的圆圈称为偏置节点。没有其他单元...", chapter_title: "人工神经网络及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 317, name: "BP神经网络的结构", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.2 BP神经网络及其学习算法/8.2.1 BP神经网络的结构", review_status: "approved", node_id: "7dc1b77c809ef89f" },
