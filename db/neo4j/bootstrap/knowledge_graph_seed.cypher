  { source_structure_id: "88275bd9a87b0b2f", aliases: ["启发信息和估价函数"], raw_name: "启发信息和估价函数", canonical_name: "启发信息和估价函数", confidence: 0.95, description: "在实际解决一个具体问题时,人们常常把一个复杂的实际问题抽象化,保留某些主要因素,忽略大量次要因素,从而将这个实际问题转化成具有明确结构的有限或无限的状态空间问题,这个状态空间中的状态和变换规律都是已知的集合,因此可以找到一个求解该问题的算法 在具体求解中,启发式搜索能够利用与该问题有关的信息来简化搜索过程,称此类信息为启发信息。然而,在求解问题中能利用...", chapter_title: "搜索求解策略", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 227, name: "启发信息和估价函数", source_path: "人工智能导论/第5章 搜索求解策略/5.4 启发式图搜索策略/5.4.2 启发信息和估价函数", review_status: "approved", node_id: "ecd7fddb9c8214f1" },
  { source_structure_id: "a026e99561d62d92", aliases: ["粒子群优化算法及其应用"], raw_name: "粒子群优化算法及其应用", canonical_name: "粒子群优化算法及其应用", confidence: 0.9, description: "在粒子群优化算法中,在n维连续搜索空间中,对粒子群中的第i ( i = 1 , 2 , \\cdots , m )个粒子,定义n维当前位置向量x ^ { i } ( k ) = [ x _ { 1 } ^ { i }x _ { 2 } ^ { i }\\cdots x _ { n } ^ { i } ] ^ { T }表示搜索空间中粒子的当前位置,n维最优...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 255, name: "粒子群优化算法及其应用", source_path: "人工智能导论/第6章 智能计算及其应用/6.6 粒子群优化算法及其应用", review_status: "approved", node_id: "ecd9b8dd6c60d3a2" },
