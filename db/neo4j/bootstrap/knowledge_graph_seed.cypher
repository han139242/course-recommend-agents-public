  { source_structure_id: "2f8251882c90eb51", aliases: ["蚁群算法的参数选择"], raw_name: "蚁群算法的参数选择", canonical_name: "蚁群算法的参数选择", confidence: 0.95, description: "从蚁群搜索最短路径的机理不难看到,算法中有关参数的不同选择对蚁群算法的性能有至关重要的影响,但其选取的方法和原则,目前尚没有理论上的依据,通常都是根据经验而定 信息素启发因子α的大小则反映了蚁群在路径搜索中随机性因素作用的强度,其值越大,蚂蚁选择以前走过的路径的可能性越大,搜索的随机性减弱。当α过大时会使蚁群的搜索过早陷入局部最优 期望值启发式因子β的...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 262, name: "蚁群算法的参数选择", source_path: "人工智能导论/第6章 智能计算及其应用/6.7 蚁群算法及其应用/6.7.2 蚁群算法的参数选择", review_status: "approved", node_id: "d5c83e145f5bbb3d" },
