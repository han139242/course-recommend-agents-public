  { source_structure_id: "acce0c85b0f49f63", aliases: ["机器学习的分类"], raw_name: "机器学习的分类", canonical_name: "机器学习的分类", confidence: 0.95, description: "机器学习可从不同的角度,根据不同的方式进行分类。例如,若按系统的学习能力分类,机器学习可分为监督学习与非监督学习,两者的主要区别是前者在学习时需要教师的示教或训练,而后者是用评价标准来代替人的监督工作;若按所学知识的表示方式分类,机器学习可分为逻辑表示法学习、产生式表示法学习、框架表示法学习等;若按机器学习的应用领域分类,机器学习可分为专家系统、机器人...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], source_line_no: 289, entity_type: "topic", name: "机器学习的分类", source_path: "人工智能导论/第7章 专家系统与机器学习/7.5 机器学习/7.5.2 机器学习的分类", review_status: "approved", node_id: "261538c727a2bdfb" },
