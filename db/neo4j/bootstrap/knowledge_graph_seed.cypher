  { source_structure_id: "curated::特征工程", aliases: ["特征工程"], raw_name: "特征工程", canonical_name: "特征工程", confidence: 1, description: "围绕特征构造、变换、选择与标准化开展的数据表示优化方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "特征工程", source_path: "curated/batch_01_machine_learning_foundation", review_status: "approved", node_id: "85d9a5d78a9bf85e" },
  { source_structure_id: "3b4d562b8521090e", aliases: ["回溯策略"], raw_name: "回溯策略", canonical_name: "回溯策略", confidence: 0.95, description: "不管是正向搜索还是逆向搜索求解问题,都是在状态空间图中找到从初始状态到目的状态的路径。路径上弧的序列对应于解题的步骤。若在选择操作算子求解问题时,能给出绝对可靠的预测或者绝对正确的选择策略,一次性地成功穿过状态空间而达到目的,构造出一条解题路径,那就不需要所谓的搜索了。但事实上,不是总能给出正确的选择,求解实际问题时必须尝试", chapter_title: "搜索求解策略", facets: [], quality_issues: [], entity_type: "method", source_line_no: 222, name: "回溯策略", source_path: "人工智能导论/第5章 搜索求解策略/5.3 盲目的图搜索策略/5.3.1 回溯策略", review_status: "approved", node_id: "86dc90ab320e21a9" },
  { source_structure_id: "curated::关系抽取", aliases: ["关系抽取"], raw_name: "关系抽取", canonical_name: "关系抽取", confidence: 1, description: "从文本中识别实体之间语义关系的知识抽取方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "关系抽取", source_path: "curated/batch_17_knowledge_graph_graph_learning", review_status: "approved", node_id: "871bb78c09416869" },
  { source_structure_id: "5cbb5319147c6505", aliases: ["A*搜索算法及其特性分析"], raw_name: "A*搜索算法及其特性分析", canonical_name: "A*搜索算法及其特性分析", confidence: 0.95, description: "思考题129 习题129 A*搜索算法是由著名的人工智能学者Nilsson提出的,它是目前最有影响的启发式图搜索算法,也称为最佳图搜索算法 定义h*(n)为状态n到目的状态的最优路径的代价,则当A搜索算法的启发函数h ( n )小于等于h*(n),即满足 h ( n ) \\leq h ^ { * } ( n ) 对所有结点n (5.4) 时,被称为A'...", chapter_title: "搜索求解策略", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 229, name: "A*搜索算法及其特性分析", source_path: "人工智能导论/第5章 搜索求解策略/5.4 启发式图搜索策略/5.4.4 A*搜索算法及其特性分析", review_status: "approved", node_id: "87e03d47501af406" },
  { source_structure_id: "curated::机制设计", aliases: ["机制设计"], raw_name: "机制设计", canonical_name: "机制设计", confidence: 1, description: "通过规则设计引导多主体行为实现期望系统目标的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "机制设计", source_path: "curated/batch_11_multi_agent_foundation", review_status: "approved", node_id: "889180d87aec0503" },
  { source_structure_id: "cad679396cba2885", aliases: ["冲突消解策略"], raw_name: "冲突消解策略", canonical_name: "冲突消解策略", confidence: 0.95, description: "在推理过程中,系统要不断地用当前已知的事实与知识库中的知识进行匹配。此时,可能发生如下三种情况 1已知事实恰好只与知识库中的一个知识匹配成功 2已知事实不能与知识库中的任何知识匹配成功 3已知事实可与知识库中的多个知识匹配成功。或者多个(组)已知事实都可与知识库中的某一个知识匹配成功;或者有多个(组)已知事实可与知识库中的多个知识匹配成功 这里已知事实...", chapter_title: "确定性推理方法", facets: [], quality_issues: [], entity_type: "method", source_line_no: 182, name: "冲突消解策略", source_path: "人工智能导论/第3章 确定性推理方法/3.1 推理的基本概念/3.1.4 冲突消解策略", review_status: "approved", node_id: "889bfbe8013528d4" },
  { source_structure_id: "curated::先修关系建模", aliases: ["先修关系建模"], raw_name: "先修关系建模", canonical_name: "先修关系建模", confidence: 1, description: "对知识点之间前置依赖关系进行表示和推断的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "先修关系建模", source_path: "curated/batch_24_intelligent_education_learning_analytics", review_status: "approved", node_id: "89396059646e1e0f" },
  { source_structure_id: "04d348e0f9f0cd5d", raw_name: "推理的定义", aliases: ["推理", "推理的定义"], canonical_name: "推理", confidence: 0.95, chapter_title: "确定性推理方法", description: "人们在对各种事物进行分析、综合并最后做出决策时,通常是从已知的事实出发,通过运用已掌握的知识,找出其中蕴涵的事实,或归纳出新的事实。这一过程通常称为推理,即从初始证据出发,按某种策略不断运用知识库中的已知知识,逐步推出结论的过程称为推理 在人工智能系统中,推理是由程序实现的,称为推理机。已知事实和知识是构成推理的两个基本要素。已知事实又称为证据,用以指...", facets: ["定义"], quality_issues: ["facet_merged"], source_line_no: 179, entity_type: "method", name: "推理", source_path: "人工智能导论/第3章 确定性推理方法/3.1 推理的基本概念/3.1.1 推理的定义", review_status: "approved", node_id: "89837c0e56b019cd" },
