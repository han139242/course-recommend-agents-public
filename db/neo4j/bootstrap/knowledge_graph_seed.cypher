  { source_structure_id: "5feff6d7071105fe", aliases: ["游戏角色的群聚"], raw_name: "游戏角色的群聚", canonical_name: "游戏角色的群聚", confidence: 0.95, description: "角色的群聚(flocking)行为是基于Craig Reynolds提出的Boids算法,该算法由三个简单的规则组成 1聚合(cohesion):每一个成员移向它的邻居成员的平均位置 2对齐(alignment):每一个成员朝向它的邻居成员的平均朝向 3分离(separation):每一个成员与邻居保持一定的距离,以免相撞 这些规则都可以利用追逐或躲避...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 383, name: "游戏角色的群聚", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.4 智能游戏角色设计基本技术/11.4.3 游戏角色的群聚", review_status: "approved", node_id: "d46189d8b7fc2264" },
