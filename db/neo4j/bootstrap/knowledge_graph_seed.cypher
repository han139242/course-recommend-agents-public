  { source_structure_id: "994e8f2ddb8c55e1", aliases: ["BP学习算法", "BP神经网络", "BP神经网络的应用"], raw_name: "BP学习算法", canonical_name: "BP神经网络", confidence: 0.95, description: "BP学习算法最早是由Werbos在1974年提出的。Rumelhart等于1985年发展了BP学习算法,实现了Minsky多层感知器的设想 BP学习算法是通过反向学习过程使误差最小,因此选择目标函数为 (8.10) \\min J = \\frac { 1 } { 2 } \\sum _ { j = 1 } ^ { p m } ( y _ { j } ^ {...", chapter_title: "人工神经网络及其应用", facets: ["应用"], quality_issues: ["facet_merged"], entity_type: "algorithm", source_line_no: 318, name: "BP神经网络", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.2 BP神经网络及其学习算法/8.2.2 BP学习算法", review_status: "approved", node_id: "bbae9d4d4a61e5e9" },
  { source_structure_id: "curated::路径规划", aliases: ["路径规划"], raw_name: "路径规划", canonical_name: "路径规划", confidence: 1, description: "为智能体或机器人寻找满足约束条件的可行路径的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "路径规划", source_path: "curated/curated_ai_professional_ontology", review_status: "approved", node_id: "bbc2cb845840bed0" },
  { source_structure_id: "curated::计算机视觉", aliases: ["计算机视觉"], raw_name: "计算机视觉", canonical_name: "计算机视觉", confidence: 1, description: "研究使计算机获取、处理并理解图像与视频信息的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], source_line_no: 0, entity_type: "topic", name: "计算机视觉", source_path: "curated/curated_ai_professional_ontology", review_status: "approved", node_id: "bc17602a49ccef3f" },
  { source_structure_id: "3831bbe2fbf6b61a", aliases: ["多智能体系统的通信"], raw_name: "多智能体系统的通信", canonical_name: "多智能体系统的通信", confidence: 0.9, description: "同一环境中的Agent之间、不同环境的Agent之间都可以进行通信。一个Agent被授权后就可以通过调用另一个Agent的方法向它发送消息 Agent进行通信就是改变信息载体,将载体发送到接收Agent的可观察环境中。采用这种通信观点可以拓展通信的形式,而不仅限于语言通信 两个Agent之间的通信过程如下 1发送方将自己的思想翻译成通信所用语言的格式 ...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "application", source_line_no: 348, name: "多智能体系统的通信", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.3 多智能体系统的通信", review_status: "approved", node_id: "bc307a1815df335c" },
  { source_structure_id: "curated::对抗训练", aliases: ["对抗训练"], raw_name: "对抗训练", canonical_name: "对抗训练", confidence: 1, description: "将对抗样本纳入训练过程以提升模型鲁棒性的防御方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "对抗训练", source_path: "curated/batch_13_ai_safety_ethics_governance", review_status: "approved", node_id: "bd9f8f3b1326c848" },
  { source_structure_id: "b5ceab4488edd623", aliases: ["智能搜索引擎"], raw_name: "智能搜索引擎", canonical_name: "智能搜索引擎", confidence: 0.95, description: "在游戏开发中,核心技术是构架游戏引擎,它是决定游戏质量的关键。游戏引擎就像赛车的引擎。引擎是赛车的心脏,决定着赛车的性能和稳定性。赛车的速度、操作感这些直接与车手相关的指标都是建立在引擎的基础上的。游戏也是如此,玩家所体验到的剧情、关卡、美工、音乐、操作等内容都是由游戏引擎直接控制的。它扮演着中场发动机的角色,将游戏中所有元素捆绑在一起,在后台指挥它们...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 385, name: "智能搜索引擎", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.4 智能游戏角色设计基本技术/11.4.5 智能搜索引擎", review_status: "approved", node_id: "be27e8c76c664483" },
  { source_structure_id: "curated::语言模型", aliases: ["语言模型"], raw_name: "语言模型", canonical_name: "语言模型", confidence: 1, description: "对词序列出现概率进行建模并支撑语言理解与生成的核心任务。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], source_line_no: 0, entity_type: "topic", name: "语言模型", source_path: "curated/batch_07_nlp_foundation", review_status: "approved", node_id: "be30faf67281c850" },
  { source_structure_id: "curated::深度优先搜索", aliases: ["深度优先搜索"], raw_name: "深度优先搜索", canonical_name: "深度优先搜索", confidence: 1, description: "沿单条路径尽可能深入再回溯的经典图搜索算法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 0, name: "深度优先搜索", source_path: "curated/batch_04_search_planning", review_status: "approved", node_id: "bee30b06ab0a13a5" },
  { source_structure_id: "f3ffbbe5e6972fe9", aliases: ["游戏角色的指导与运动"], raw_name: "游戏角色的指导与运动", canonical_name: "游戏角色的指导与运动", confidence: 0.95, description: "有两种方法指导角色行为:预定义行为(predefined behavior)和目标导向行为(goal-directedbehavior)。区分预定义行为和目标导向行为的依据是:角色是否唯一地选择行动 预定义行为指导角色行为方法中,角色的所有行为都是动画师和程序设计人员预先设计的。这里讨论的主要是如何处理预先并不完全确定的角色行为的技术。两种比较流行的方...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 381, name: "游戏角色的指导与运动", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.4 智能游戏角色设计基本技术/11.4.1 游戏角色的指导与运动", review_status: "approved", node_id: "bef6d20b2035f2d3" },
