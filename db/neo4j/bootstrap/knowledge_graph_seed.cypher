  { source_structure_id: "5afeaff840d8d828", aliases: ["示例学习"], raw_name: "示例学习", canonical_name: "示例学习", confidence: 0.95, description: "人们要解决一个新的问题,常常是将过去成功解决的类似的案例,用于求解新的问题。例如,医生在对某个病人作了检查后,会想到以前看过的病人的情况,找出几个在重要病症上相似的病人,将那些病人的诊断和治疗方案用于这个病人。这就是示例学习的基本思想 示例学习(Learning From Examples)又称为实例学习或从例子中学习。示例学习是通过从环境中取得若干与...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 292, name: "示例学习", source_path: "人工智能导论/第7章 专家系统与机器学习/7.5 机器学习/7.5.5 示例学习", review_status: "approved", node_id: "6670c88a31e3f7e5" },
  { source_structure_id: "4d85444247ee9ff8", aliases: ["鲁宾孙归结原理"], raw_name: "鲁宾孙归结原理", canonical_name: "鲁宾孙归结原理", confidence: 0.9, description: "从前面的分析可以看出,谓词公式的不可满足性分析可以转化为子句集中子句的不可满足性分析。为了判定子句集的不可满足性,就需要对子句集中的子句进行判定。而为了判定一个子句的不可满足性,需要对个体域上的一切解释逐个地进行判定,只有当子句对任何非空个体域上的任何一个解释都是不可满足的时候,才能判定该子句是不可满足的,这是一件非常困难的工作,要在计算机上实现其证明...", chapter_title: "确定性推理方法", facets: [], quality_issues: [], entity_type: "method", source_line_no: 185, name: "鲁宾孙归结原理", source_path: "人工智能导论/第3章 确定性推理方法/3.4 鲁宾孙归结原理", review_status: "approved", node_id: "66ca4343b4ddf4ff" },
