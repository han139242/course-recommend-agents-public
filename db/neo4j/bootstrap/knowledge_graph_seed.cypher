  { source_structure_id: "da08e94cf0748b7b", aliases: ["专家系统实例"], raw_name: "专家系统实例", canonical_name: "专家系统实例", confidence: 0.9, description: "3运行效率。检测系统在知识查询及推理方面的运行效率,找出薄弱环节及求解方法与策略方面的问题 4解释能力。对解释能力的检测主要从两个方面进行:一是检测它能回答哪些问题,是否达到了要求;二是检测回答问题的质量,即是否有说服力 5人机交互的便利性。为了设计出友好的人机接口,在系统设计之前和设计过程中也要让用户参与。这样才能准确地表达用户的要求 对人机接口的测...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "application", source_line_no: 300, name: "专家系统实例", source_path: "人工智能导论/第7章 专家系统与机器学习/7.8 专家系统实例", review_status: "approved", node_id: "21e8aa77a5bff9f9" },
