  { source_structure_id: "56dae0a1e89bf236", aliases: ["宽度优先搜索策略"], raw_name: "宽度优先搜索策略", canonical_name: "宽度优先搜索策略", confidence: 0.95, description: "宽度优先搜索策略是按照图5.8所示的次序来搜索状态的。由S _ { 0 }生成状态1,2,然后扩展状态1,生成状态3,4,5,接着扩展状态2,生成状态6,7,8,该层扩展完后,再进入下一层,对状态 114 第5章 搜索求解策略 3进行扩展,如此一层一层地扩展下去,直到搜索到目的状态(如果目的状态存在) S _ { 0 } 图5.8 宽度优先搜索策略中状...", chapter_title: "搜索求解策略", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 223, name: "宽度优先搜索策略", source_path: "人工智能导论/第5章 搜索求解策略/5.3 盲目的图搜索策略/5.3.2 宽度优先搜索策略", review_status: "approved", node_id: "4df6cf1ce0c7cf9a" },
