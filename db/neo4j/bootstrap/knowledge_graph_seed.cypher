  { source_structure_id: "5934373f9eee8b56", aliases: ["知识发现与数据挖掘", "知识发现与数据挖掘的概念"], raw_name: "知识发现与数据挖掘", canonical_name: "知识发现与数据挖掘", confidence: 0.95, description: "随着计算机和网络技术的迅速发展,出现了以数据库和数据仓库为存储单位的海量数据,而且这种数据仍然在以惊人的速度不断增长。如何对这些海量数据进行有效处理,特别是如何从这些数据中归纳、提取出高一级的更本质、更有用的规律性信息,就成了信息领域的一个重要课题。事实上,这些海量数据不仅承载着大量的信息,同时也蕴藏着丰富的知识。正是在这样的背景下,知识发现与数据挖掘...", chapter_title: "专家系统与机器学习", facets: ["概念"], quality_issues: ["facet_merged"], entity_type: "concept", source_line_no: 293, name: "知识发现与数据挖掘", source_path: "人工智能导论/第7章 专家系统与机器学习/7.6 知识发现与数据挖掘", review_status: "approved", node_id: "e2a51fcf8f0ce6a4" },
  { source_structure_id: "5bd665e2cbb46b13", aliases: ["复合式 Agent"], raw_name: "复合式 Agent", canonical_name: "复合式 Agent", confidence: 0.95, description: "", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 342, name: "复合式 Agent", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.1 智能体的概念与结构/9.1.6 复合式 Agent", review_status: "approved", node_id: "e2cf0176203e338e" },
  { source_structure_id: "6a5083e20bfcf3b0", aliases: ["多智能体的协作类型"], raw_name: "多智能体的协作类型", canonical_name: "多智能体的协作类型", confidence: 0.95, description: "根据智能体之间目标的关系以及协作的程度,可将协作分为如下五种类型 1完全协作型。系统中的智能体都围绕一个共同的全局目标,各个智能体没有自己的局部目标,所有智能体全力以赴地协作 2协作型。系统中的智能体具有一个共同的全局目标,同时各个智能体还有与全局目标一", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "application", source_line_no: 354, name: "多智能体的协作类型", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.5 多智能体系统的协作/9.5.1 多智能体的协作类型", review_status: "approved", node_id: "e303b820967f6ed0" },
  { source_structure_id: "c2d9134a2336f28f", aliases: ["智能游戏开发方法"], raw_name: "智能游戏开发方法", canonical_name: "智能游戏开发方法", confidence: 0.95, description: "实现游戏智能有两种不同的方式。一种是采用传统的编程技术,使系统呈现智能的效果,而不考虑所用方法是否与人或者动物所用的方法相同。这种方法称为工程学方法(engineering ap-proach),它已经在文字识别、电脑下棋等许多领域应用。另一种是模拟法(modeling approach),它不仅要看效果,还要求实现方法也和人类或动物机体所用的方法相同...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "method", source_line_no: 387, name: "智能游戏开发方法", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.5 智能游戏开发方法与开发工具/11.5.1 智能游戏开发方法", review_status: "approved", node_id: "e3208a7587c8b49e" },
  { source_structure_id: "curated::实验可重复性", aliases: ["实验可重复性"], raw_name: "实验可重复性", canonical_name: "实验可重复性", confidence: 1, description: "他人使用相同数据、代码与随机种子等条件能够复现主要结果的程度。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 0, name: "实验可重复性", source_path: "curated/batch_25_ai_evaluation_benchmark_experiment_design", review_status: "approved", node_id: "e349675398cd6f67" },
  { source_structure_id: "0dc0d4861d53abe5", aliases: ["用遗传算法求解下列函数的最大值"], raw_name: "用遗传算法求解下列函数的最大值", canonical_name: "用遗传算法求解下列函数的最大值", confidence: 0.9, description: "f ( x ) = 0 . 4 + \\sin c ( 4 x ) + 1 . 1 \\sin c ( 4 x + 2 ) + 0 . 8 \\sin c ( x - 2 ) + 0 . 7 \\sin c ( 6 x - 4 ), x \\in [ - 2 , 2 ]其中 \\sin c ( x ) = \\{ \\begin{matrix} 1 , x = 0 \\...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 5323, name: "用遗传算法求解下列函数的最大值", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/6.2 用遗传算法求解下列函数的最大值", review_status: "approved", node_id: "e42e93778e865a4d" },
  { source_structure_id: "4774c6b1e8ef8dab", aliases: ["智能游戏开发方法与开发工具"], raw_name: "智能游戏开发方法与开发工具", canonical_name: "智能游戏开发方法与开发工具", confidence: 0.9, description: "需要调用游戏引擎中相关的API函数。同样在游戏里,剧情的进行、形形色色的角色衬托、各种场景的交换,也都是游戏引擎事先就约定的一种模式或大体的框架,然后依靠一些复杂的数据库来组织完成 游戏引擎从20世纪90年代初开始,经历了诞生、发展、成熟三个阶段。在每个阶段,都有优秀的游戏引擎产生,它们组成了游戏引擎的演化史。从2000年开始,游戏引擎朝着两个不同的方...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "method", source_line_no: 386, name: "智能游戏开发方法与开发工具", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.5 智能游戏开发方法与开发工具", review_status: "approved", node_id: "e44e2014f12bf09e" },
