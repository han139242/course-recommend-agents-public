  { source_structure_id: "143ca86653f59217", raw_name: "专家系统的概念", aliases: ["专家系统", "专家系统的一般结构", "专家系统的定义", "专家系统的应用", "专家系统的概念", "专家系统的特点"], canonical_name: "专家系统", confidence: 0.95, chapter_title: "专家系统与机器学习", description: "目录 III 何运用前两种知识的知识,如在问题求解中的搜索策略、推理方法等。专家系统具有的知识越丰富,质量越高,解决问题的能力就越强 2.能进行有效的推理 专家系统的核心是知识库和推理机。专家系统要利用专家知识来求解领域内的具体问题,必须有一个推理机构,能根据用户提供的已知事实,通过运用知识库中的知识,进行有效的推理,以实现问题的求解。专家系统不仅能根...", facets: ["定义", "应用", "概念", "特点", "结构"], quality_issues: ["facet_merged"], source_line_no: 269, entity_type: "topic", name: "专家系统", source_path: "人工智能导论/第7章 专家系统与机器学习/7.2 专家系统的概念", review_status: "approved", node_id: "a0a5de74251bea58" },
