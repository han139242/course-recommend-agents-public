  { source_structure_id: "be8c83a1de9307de", aliases: ["基本遗传算法", "遗传算法", "遗传算法的一般步骤", "遗传算法的基本思想", "遗传算法的应用", "遗传算法的特点"], raw_name: "基本遗传算法", canonical_name: "遗传算法", confidence: 0.95, description: "要特性保证了种群的多样性 生物进化中种群经过婚配产生子代群体(简称子群)。在进化的过程中,可能会因为变异而产生新的个体。每个基因编码了生物机体的某种特征,如头发的颜色、耳朵的形状等。综合变异的作用使子群成长为新的群体而取代旧群体。在新的一个循环过程中,新的群体代替旧的群体而成为循环的开始 对于自然界中生物遗传与进化机理的模仿,针对不同的问题设计了许多不...", chapter_title: "智能计算及其应用", facets: ["应用", "思想", "步骤", "特点"], quality_issues: ["facet_merged"], entity_type: "algorithm", source_line_no: 238, name: "遗传算法", source_path: "人工智能导论/第6章 智能计算及其应用/6.2 基本遗传算法", review_status: "approved", node_id: "f8e123b364698403" },
