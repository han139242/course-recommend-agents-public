  { source_structure_id: "b0305afcd2c5fd3b", aliases: ["知识获取的模式"], raw_name: "知识获取的模式", canonical_name: "知识获取的模式", confidence: 0.95, description: "按知识获取的自动化程度划分,知识获取主要有非自动、自动和半自动三种获取模式 1.非自动知识获取(人工移植) 非自动知识获取也称为人工移植。在这种方式中,知识获取分两步进行,首先由知识工程师从领域专家或有关的科技文献那里获取知识,然后再由知识工程师用某种知识编辑器输入到知识库中,其工作方式如图7.3所示 科技文献 阅 读 一 对 话 知识 知识 知识库 ...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 286, name: "知识获取的模式", source_path: "人工智能导论/第7章 专家系统与机器学习/7.4 知识获取的主要过程与模式/7.4.2 知识获取的模式", review_status: "approved", node_id: "60537dacf93259a5" },
  { source_structure_id: "e51e88b92eebe81c", aliases: ["搜索策略"], raw_name: "搜索策略", canonical_name: "搜索策略", confidence: 0.95, description: "(1)从初始状态出发的正向搜索,也称为数据驱动 正向搜索是从问题给出的条件-一个用于状态转换的操作算子集合出发的。搜索的过程为应用操作算子从给定的条件中产生新条件,再用操作算子从新条件产生更多的新条件,这个过程一直持续到有一条满足目的要求的路径产生为止。数据驱动就是用问题给定数据中的约束知识指导搜索,使其沿着那些已知是正确的线路前进 (2)从目的状态出...", chapter_title: "搜索求解策略", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 217, name: "搜索策略", source_path: "人工智能导论/第5章 搜索求解策略/5.1 搜索的概念/5.1.2 搜索策略", review_status: "approved", node_id: "6082cf5b975a63c2" },
