  { source_structure_id: "0e0dee5d3c7fa9ed", aliases: ["基本的游戏人工智能技术"], raw_name: "基本的游戏人工智能技术", canonical_name: "基本的游戏人工智能技术", confidence: 0.95, description: "目前,基本的游戏人工智能技术有 1.搜索技术 搜索技术在现代游戏中应用非常广泛,特别是用于路径规划。当前棋类游戏几乎都使用了搜索的方式来完成决策的,其中最优秀的是搜索树、蒙特卡洛搜索树。搜索的游戏人工智能更关注的是预测和评估,决策的制定只是挑选出预测的最好方式即可。在追捕游戏中,只要追逐角色与任一非追逐角色相邻,所对应的状态就是目标状态。对于简单的情况...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 378, name: "基本的游戏人工智能技术", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.2 游戏人工智能/11.2.2 基本的游戏人工智能技术", review_status: "approved", node_id: "3b9046baee07df93" },
