  { source_structure_id: "26a6d99dc99ed25d", aliases: ["变异", "基本遗传算法变异"], raw_name: "变异", canonical_name: "基本遗传算法变异", confidence: 0.95, description: "如果生物繁殖仅仅是上述交叉过程,那么即使经历成千上万代以后,适应能力最强的成员的眼睛尺寸也只能像初始群体中的最大眼睛一样。而根据对自然的观察中可以看到,人类的眼睛尺寸实际存在一代比一代大的趋势。这是因为当基因传递给子孙后代的过程中,会有很小的概率发生差错,从而使基因发生微小的改变,这就是基因的变异。发生变异的概率通常都很小,但在经历许多代以后变异就会很...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], source_line_no: 246, entity_type: "algorithm", name: "基本遗传算法变异", source_path: "人工智能导论/第6章 智能计算及其应用/6.2 基本遗传算法/6.2.8 变异", review_status: "approved", node_id: "aa0a8fe3418f03c7" },
