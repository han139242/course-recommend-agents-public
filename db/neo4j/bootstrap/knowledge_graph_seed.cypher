  { source_structure_id: "curated::数据层", aliases: ["数据层"], raw_name: "数据层", canonical_name: "数据层", confidence: 1, description: "承载具体实体、属性和值等实例化知识的知识图谱底层结构。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 0, name: "数据层", source_path: "curated/batch_17_knowledge_graph_graph_learning", review_status: "approved", node_id: "1993e738fc047175" },
  { source_structure_id: "282db066eac86775", aliases: ["多智能体系统的体系结构"], raw_name: "多智能体系统的体系结构", canonical_name: "多智能体系统的体系结构", confidence: 0.95, description: "MAS的体系结构影响系统的异步性、一致性、自主性和自适应性的程度,决定信息的存储方式、共享方式和通信方式。体系结构中必须有共同的通信协议或传递机制。对于不同复杂程度的应用,应选择不同能力的体系结构 下面介绍几种常见的MAS的体系结构 1.网络结构 网络结构中的Agent之间都是直接通信的,通信和状态知识都是固定的。网络结构的Agent系统中的每个Age...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "application", source_line_no: 347, name: "多智能体系统的体系结构", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.2 多智能体系统的概念与结构/9.2.3 多智能体系统的体系结构", review_status: "approved", node_id: "19d6381a3db22b5d" },
  { source_structure_id: "fd42fb47e691ab26", aliases: ["遗传算法的改进算法"], raw_name: "遗传算法的改进算法", canonical_name: "遗传算法的改进算法", confidence: 0.9, description: "问题 确定表示问题解的染色体(编码) 初始化种群 计算每个个体的适应值 是否满足终止条件? 根据适应值选择 交叉 输出最优解 变异 图6.2 遗传算法的基本流程 来评估个体,并在此基础上进行遗传操作,使种群中个体之间进行信息交换。特别是遗传算法的适应度函数不仅不受连续可微的约束,而且其定义域也可以任意设定。对适应度函数的唯一要求是能够算出可以比较的正值...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 249, name: "遗传算法的改进算法", source_path: "人工智能导论/第6章 智能计算及其应用/6.3 遗传算法的改进算法", review_status: "approved", node_id: "1a3b363ffaf15aa7" },
  { source_structure_id: "curated::本体", aliases: ["本体"], raw_name: "本体", canonical_name: "本体", confidence: 1, description: "对领域概念、关系与约束进行共享形式化描述的知识组织模型。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 0, name: "本体", source_path: "curated/curated_ai_professional_ontology", review_status: "approved", node_id: "1a8239858e8638a2" },
  { source_structure_id: "44ba8f24fbfd08b3", aliases: ["机器学习的基本概念"], raw_name: "机器学习的基本概念", canonical_name: "机器学习的基本概念", confidence: 0.95, description: "学习是一个有特定目的的知识获取过程,其内在行为是获取知识、积累经验、发现规律;外部表现是改进性能、适应环境、实现系统的自我完善 机器学习(Machine Learning)使计算机能模拟人的学习行为,自动地通过学习来获取知识和技能,不断改善性能,实现自我完善 作为人工智能的一个研究领域,机器学习主要研究以下三方面问题 1学习机理。这是对人类学习机制的研...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], source_line_no: 288, entity_type: "topic", name: "机器学习的基本概念", source_path: "人工智能导论/第7章 专家系统与机器学习/7.5 机器学习/7.5.1 机器学习的基本概念", review_status: "approved", node_id: "1b79f67d66db6fe7" },
  { source_structure_id: "938276c669750d7e", aliases: ["启发式图搜索策略"], raw_name: "启发式图搜索策略", canonical_name: "启发式图搜索策略", confidence: 0.9, description: "前节所介绍的大部分搜索方法都是盲目搜索方法,其搜索的复杂性往往是很高的。为了提高算法的效率,必须放弃利用纯数学的方法来决定搜索结点的次序,而需要对具体问题作具体分析,利用与问题有关的信息,从中得到启发来引导搜索,以达到减少搜索量的目的,这就是启发式搜索 本节先对启发及启发式策略所涉及的问题作一介绍,然后具体介绍启发式图搜索算法-A及A*算法,最后讨论启...", chapter_title: "搜索求解策略", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 225, name: "启发式图搜索策略", source_path: "人工智能导论/第5章 搜索求解策略/5.4 启发式图搜索策略", review_status: "approved", node_id: "1b7a4455c587cca1" },
  { source_structure_id: "f2088addfa6e2896", aliases: ["框架表示法", "框架表示法的特点"], raw_name: "框架表示法", canonical_name: "框架表示法", confidence: 0.95, chapter_title: "知识表示", description: "1975年美国著名的人工智能学者明斯基提出了框架理论。该理论认为人们对现实世界中各种事物的认识都是以一种类似于框架的结构存储在记忆中的。当面临一个新事物时,就从记忆中找出一个合适的框架,并根据实际情况对其细节加以修改、补充,从而形成对当前事物的认识。例如,一个人走进一个教室之前就能依据以往对“教室”的认识,想象到这个教室一定有四面墙,有门、窗,有天花板...", facets: ["特点"], quality_issues: ["facet_merged"], entity_type: "method", source_line_no: 170, name: "框架表示法", source_path: "人工智能导论/第2章 知识表示/2.4 框架表示法", review_status: "approved", node_id: "1bb96454a2e302a6" },
  { source_structure_id: "curated::Grad-CAM", aliases: ["Grad-CAM"], raw_name: "Grad-CAM", canonical_name: "Grad-CAM", confidence: 1, description: "利用卷积网络梯度对特征图加权并上采样得到类判别区域热图的视觉解释方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "Grad-CAM", source_path: "curated/batch_26_explainability_causal_robustness", review_status: "approved", node_id: "1bf55ef992d229ce" },
  { source_structure_id: "curated::经验风险最小化", aliases: ["经验风险最小化"], raw_name: "经验风险最小化", canonical_name: "经验风险最小化", confidence: 1, description: "通过最小化训练样本平均损失学习模型参数的基本原则。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], source_line_no: 0, entity_type: "concept", name: "经验风险最小化", source_path: "curated/batch_01_machine_learning_foundation", review_status: "approved", node_id: "1cc34ecf070866cd" },
  { source_structure_id: "curated::链接预测", aliases: ["链接预测"], raw_name: "链接预测", canonical_name: "链接预测", confidence: 1, description: "预测图中潜在边是否存在及其可能类型的图学习任务。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "application", source_line_no: 0, name: "链接预测", source_path: "curated/batch_17_knowledge_graph_graph_learning", review_status: "approved", node_id: "1d3410b6c7411c1b" },
  { source_structure_id: "9b25e6a7c6ef49de", aliases: ["智能体通信语言"], raw_name: "智能体通信语言", canonical_name: "智能体通信语言", confidence: 0.95, description: "智能体之间的交互和协调是通过智能体之间的通信来完成的。当前智能体在完成了对其他智能体的建模之后,如果要对其他智能体进行控制和协调,比如改变其他智能体的目标,知识或者是对环境的置信,就应该通过通信动作来完成 多智能体系统的一个最显著的特征是各个智能体在满足自身利益的同时,通过相互之间的协商和合作,共同完成单一智能体无法完成的任务。智能体要进行协商和合作,...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], source_line_no: 351, entity_type: "topic", name: "智能体通信语言", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.3 多智能体系统的通信/9.3.3 智能体通信语言", review_status: "approved", node_id: "1d4047b3207bbb0f" },
  { source_structure_id: "ca0fb367d86c73fe", aliases: ["隐马尔可夫模型"], raw_name: "隐马尔可夫模型", canonical_name: "隐马尔可夫模型", confidence: 0.95, description: "马尔可夫模型是俄国数学家Markov在1907年研究俄国文学家普希金作品《奥涅金》中不同", chapter_title: "自然语言处理及其应用", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 370, name: "隐马尔可夫模型", source_path: "人工智能导论/第10章 自然语言处理及其应用/10.4 语音识别/10.4.3 隐马尔可夫模型", review_status: "approved", node_id: "1d4da69a0b6413e8" },
  { source_structure_id: "b108d6807b8279e4", aliases: ["扫雷机智能游戏开发"], raw_name: "扫雷机智能游戏开发", canonical_name: "扫雷机智能游戏开发", confidence: 0.9, description: "扫雷机工作在一个很简单的环境中,只需要若干扫雷机和随机散布的许多地雷。游戏设计目标是设计一个BP神经网络,能够自己演化去寻找地雷 基本方法是用一个BP神经网络控制一个扫雷机,它的权值用遗传算法进行演化,使扫雷机更聪明 可以把扫雷机看成与坦克一样,通过左右两个能够转动的履带式轮轨来行动。通过改变两个轮轨的相对速度来控制扫雷机前进的速度以及向左或者向右转弯...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 389, name: "扫雷机智能游戏开发", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.6 扫雷机智能游戏开发", review_status: "approved", node_id: "1d642e5f90e4582b" },
