  { source_structure_id: "29b705a695ec41c0", aliases: ["神经网络的结构与工作方式"], raw_name: "神经网络的结构与工作方式", canonical_name: "神经网络的结构与工作方式", confidence: 0.95, description: "1.神经网络的结构 神经网络是由众多简单的神经元连接而成的一个网络。尽管每个神经元结构、功能都不复 212 第8章 人工神经网络及其应用 杂,但神经网络的行为并不是各单元行为的简单相加,网络的整体动态行为则是极为复杂的,可以组成高度非线性动力学系统,从而可以描述很多复杂的物理系统,表现出一般复杂非线性系统的特性(如不可预测性、不可逆性、多吸引子、可能出...", chapter_title: "人工神经网络及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 314, name: "神经网络的结构与工作方式", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.1 神经元与神经网络/8.1.3 神经网络的结构与工作方式", review_status: "approved", node_id: "27702441d4eb849b" },
