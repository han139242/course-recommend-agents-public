  { source_structure_id: "curated::逆运动学", aliases: ["逆运动学"], raw_name: "逆运动学", canonical_name: "逆运动学", confidence: 1, description: "根据目标位姿求解机器人关节变量的运动学分析方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "逆运动学", source_path: "curated/batch_12_robotics_embodied_ai_foundation", review_status: "approved", node_id: "687bbcc27aaaf3cf" },
  { source_structure_id: "7d77bf93c0a98e88", aliases: ["推理的方向"], raw_name: "推理的方向", canonical_name: "推理的方向", confidence: 0.95, description: "推理过程是求解问题的过程。问题求解的质量与效率不仅依赖于所采用的求解方法(如匹配方法、不确定性的传递算法等),而且还依赖于求解问题的策略,即推理的控制策略 推理的控制策略主要包括推理方向、搜索策略、冲突消解策略、求解策略及限制策略等。推理方向分为正向推理、逆向推理、混合推理及双向推理四种 1.正向推理 正向推理是以已知事实作为出发点的一种推理 正向推理...", chapter_title: "确定性推理方法", facets: [], quality_issues: [], entity_type: "method", source_line_no: 181, name: "推理的方向", source_path: "人工智能导论/第3章 确定性推理方法/3.1 推理的基本概念/3.1.3 推理的方向", review_status: "approved", node_id: "6901b5441058c2a6" },
