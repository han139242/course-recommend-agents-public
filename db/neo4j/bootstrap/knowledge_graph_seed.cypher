  { source_structure_id: "bf60f56e9ef21d3a", aliases: ["人工智能游戏的现状与未来"], raw_name: "人工智能游戏的现状与未来", canonical_name: "人工智能游戏的现状与未来", confidence: 0.9, description: "思考题291 附录A 部分习题解答293 附录B 实验指导书301 参考文献316 章 绪论 人工智能是在计算机科学、控制论、信息论、神经心理学、哲学、语言学等多学科研究的基础上发展起来的综合性很强的交叉学科,是一门新思想、新观念、新理论、新技术不断出现的新兴学科,也是正在迅速发展的前沿学科。自1956年正式提出人工智能这个术语并把它作为一门新兴学科的...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 390, name: "人工智能游戏的现状与未来", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.7 人工智能游戏的现状与未来", review_status: "approved", node_id: "af277a22fce1a14e" },
