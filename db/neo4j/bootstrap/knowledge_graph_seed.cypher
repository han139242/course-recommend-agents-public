  { source_structure_id: "d43570120028d14d", aliases: ["进化算法", "进化算法的概念"], raw_name: "进化算法的概念", canonical_name: "进化算法", confidence: 0.95, description: "进化算法(Evolutionary Algorithms,EA)是基于自然选择和自然遗传等生物进化机制的一种搜索算法。进化算法是以达尔文的进化论思想为基础,通过模拟生物进化过程与机制的求解问题的自组织、自适应的人工智能技术,是一类借鉴生物界自然选择和自然遗传机制的随机搜索算法,这些方法本质上从不同的角度对达尔文的进化原理进行了不同的运用和阐述,非常适用...", chapter_title: "智能计算及其应用", facets: ["概念"], quality_issues: ["facet_merged"], entity_type: "algorithm", source_line_no: 235, name: "进化算法", source_path: "人工智能导论/第6章 智能计算及其应用/6.1 进化算法的产生与发展/6.1.1 进化算法的概念", review_status: "approved", node_id: "41e39bd2acecd48d" },
  { source_structure_id: "06f9a7989d7bf4cc", aliases: ["专家系统开发环境"], raw_name: "专家系统开发环境", canonical_name: "专家系统开发环境", confidence: 0.95, description: "专家系统开发环境又称为专家系统开发工具包,它可为专家系统的开发提供多种方便的构件,如知识获取的辅助工具、适用各种不同知识结构的知识表示模式、各种不同的不确定推理机制、知识库管理系统以及各种不同的辅助工具、调试工具等。目前,国内外已有的专家系统开发环境有AGE,KEE等。这里只简单地介绍AGE AGE是斯坦福大学研制的一个专家系统开发环境。它是一种典型的...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "application", source_line_no: 306, name: "专家系统开发环境", source_path: "人工智能导论/第7章 专家系统与机器学习/7.9 专家系统的开发工具/7.9.3 专家系统开发环境", review_status: "approved", node_id: "424e6e22799580ef" },
  { source_structure_id: "c3c6285d18c08078", aliases: ["一阶谓词逻辑知识表示方法", "一阶谓词逻辑表示法", "一阶谓词逻辑表示法的特点"], raw_name: "一阶谓词逻辑表示法", canonical_name: "一阶谓词逻辑表示法", confidence: 0.95, chapter_title: "知识表示", description: "相应的知识是不精确、不确定的。因而不完全性是使知识具有不确定性的一个重要原因 3.可表示性与可利用性 知识的可表示性是指知识可以用适当形式表示出来,如用语言、文字、图形、神经网络等,这样才能被存储、传播。知识的可利用性是指知识可以被利用。这是不言而喻的,人们每天都在利用自己掌握的知识解决所面临的各种问题 人工智能中用到的逻辑可划分为两大类。一类是经典命...", facets: ["特点"], quality_issues: ["facet_merged"], source_line_no: 158, entity_type: "method", name: "一阶谓词逻辑表示法", source_path: "人工智能导论/第2章 知识表示/2.2 一阶谓词逻辑表示法", review_status: "approved", node_id: "429fefb8e5589547" },
  { source_structure_id: "f5bb29a7560f49ce", aliases: ["遗传算法的发展历史"], raw_name: "遗传算法的发展历史", canonical_name: "遗传算法的发展历史", confidence: 0.95, description: "遗传算法的研究兴起在20世纪80年代末和90年代初,但它的历史起源可追溯到20世纪60年代初期。早期的研究大多以对自然遗传系统的计算机模拟为主,其特点是侧重于对某些复杂操作的研究。虽然其中像自动博弈、生物模拟、模式识别和函数优化等给人以深刻的印象,但总的来说,这是一个无明确目标的发展时期,缺乏带有指导性的理论和计算工具的开拓。这种现象直到20世纪70年...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 240, name: "遗传算法的发展历史", source_path: "人工智能导论/第6章 智能计算及其应用/6.2 基本遗传算法/6.2.2 遗传算法的发展历史", review_status: "approved", node_id: "42e12bd5e2eba3b2" },
  { source_structure_id: "79b32eb68ed749e3", aliases: ["双种群遗传算法"], raw_name: "双种群遗传算法", canonical_name: "双种群遗传算法", confidence: 0.95, description: "1.基本思想 基本遗传算法针对一个宏观的种群进行复制、交叉、变异三种操作,类似于人类进化过程,一群人随着时间的推移而不断地进化,并具备越来越多的优良品质。然而由于他们的生长、演化、环境和原始祖先的局限性,经过相当长的时间后,他们将逐渐进化到某些特征相对优势的状态,称之为平衡态。当一个种群进化到这种状态,这个种群的特性就不会再有很大的变化。为了解", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 251, name: "双种群遗传算法", source_path: "人工智能导论/第6章 智能计算及其应用/6.3 遗传算法的改进算法/6.3.2 双种群遗传算法", review_status: "approved", node_id: "42ed3a8c5d7c6aff" },
  { source_structure_id: "curated::红队测试", aliases: ["红队测试"], raw_name: "红队测试", canonical_name: "红队测试", confidence: 1, description: "通过模拟恶意使用和极端场景主动发现人工智能系统薄弱点的测试方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "红队测试", source_path: "curated/batch_13_ai_safety_ethics_governance", review_status: "approved", node_id: "43294253deee63b1" },
  { source_structure_id: "curated::概率校准", aliases: ["概率校准"], raw_name: "概率校准", canonical_name: "概率校准", confidence: 1, description: "将模型输出分数映射为更可靠概率估计的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "概率校准", source_path: "curated/batch_02_reasoning_uncertainty", review_status: "approved", node_id: "4380107e8f1afcf1" },
  { source_structure_id: "curated::生成式模型", aliases: ["生成式模型"], raw_name: "生成式模型", canonical_name: "生成式模型", confidence: 1, description: "学习数据生成过程或联合分布以产生新样本的模型类别。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], source_line_no: 0, entity_type: "topic", name: "生成式模型", source_path: "curated/curated_ai_professional_ontology", review_status: "approved", node_id: "439e665e83cfbabe" },
  { source_structure_id: "69c56fb8808c3bb7", aliases: ["一阶谓词逻辑表示法命题", "命题"], raw_name: "命题", canonical_name: "一阶谓词逻辑表示法命题", confidence: 0.95, description: "谓词逻辑是在命题逻辑基础上发展起来的,命题逻辑可看作是谓词逻辑的一种特殊形式。下面首先讨论命题的概念 定义2.1 命题(proposition)是一个非真即假的陈述句 判断一个句子是否为命题,首先应该判断它是否为陈述句,再判断它是否有唯一的真值。没有真假意义的语句(如感叹句、疑问句等)不是命题 若命题的意义为真,称它的真值为真,记作T(True);若命...", chapter_title: "知识表示", facets: [], quality_issues: [], entity_type: "method", source_line_no: 159, name: "一阶谓词逻辑表示法命题", source_path: "人工智能导论/第2章 知识表示/2.2 一阶谓词逻辑表示法/2.2.1 命题", review_status: "approved", node_id: "43c0cb68ec9ab6bf" },
  { source_structure_id: "cb13f6b0d2c76c99", aliases: ["专家系统的产生和发展"], raw_name: "专家系统的产生和发展", canonical_name: "专家系统的产生和发展", confidence: 0.9, description: "专家系统(Expert System)的第一个里程碑是斯坦福大学费根鲍姆等人于1968年研制成功分析化合物分子结构的专家系统-DENDRAL系统,它达到了专家的水平。此后,相继建立了各种不同功能、不同类型的专家系统。MYCSYMA系统是由麻省理工学院(MIT)于1971年开发成功并投入应用的专家系统,用LISP语言实现对特定领域的数学问题进行有效的处理...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "application", source_line_no: 268, name: "专家系统的产生和发展", source_path: "人工智能导论/第7章 专家系统与机器学习/7.1 专家系统的产生和发展", review_status: "approved", node_id: "442e1b5d1ab59649" },
  { source_structure_id: "curated::自编码器", aliases: ["自编码器"], raw_name: "自编码器", canonical_name: "自编码器", confidence: 1, description: "通过编码和解码重构输入数据以学习紧凑表示的神经网络模型。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 0, name: "自编码器", source_path: "curated/batch_06_neural_deep_learning_foundation", review_status: "approved", node_id: "445e9bbb5de4aab2" },
  { source_structure_id: "6d373bcda31d1f9e", aliases: ["知识发现的任务"], raw_name: "知识发现的任务", canonical_name: "知识发现的任务", confidence: 0.95, description: "所谓知识发现的任务,就是知识发现所要得到的具体结果 1.数据总结 数据总结的目的是对数据进行浓缩,给出它的紧凑描述。传统的也是最简单的数据总结方法是计算出数据库的各个字段上的求和值、平均值、方差值等统计值,或者用直方图、饼状图等图形方式表示。数据挖掘主要关心从数据泛化的角度来讨论数据总结。数据泛化是一种把数据库 188 第7章 专家系统与机器学习 中的...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 296, name: "知识发现的任务", source_path: "人工智能导论/第7章 专家系统与机器学习/7.6 知识发现与数据挖掘/7.6.3 知识发现的任务", review_status: "approved", node_id: "44db7431acbb4d0f" },
  { source_structure_id: "curated::抓取", aliases: ["抓取"], raw_name: "抓取", canonical_name: "抓取", confidence: 1, description: "机器人对目标物体进行接近、接触和稳定持握的操作任务。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "application", source_line_no: 0, name: "抓取", source_path: "curated/batch_12_robotics_embodied_ai_foundation", review_status: "approved", node_id: "453420f27e24a51a" },
  { source_structure_id: "curated::非单调推理", aliases: ["非单调推理"], raw_name: "非单调推理", canonical_name: "非单调推理", confidence: 1, description: "允许在新知识出现后撤回先前结论的推理方式。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "非单调推理", source_path: "curated/batch_03_knowledge_representation_logic", review_status: "approved", node_id: "4572277c957df1a9" },
  { source_structure_id: "8fda53162900b47f", aliases: ["推理的基本概念"], raw_name: "推理的基本概念", canonical_name: "推理的基本概念", confidence: 0.9, description: "由于这种推理允许默认某些条件是成立的,所以在知识不完全的情况下也能进行。在默认推理的过程中,如果到某一时刻发现原先所做的默认不正确,则要撤销所做的默认以及由此默认推出的所有结论,重新按新情况进行推理 2.确定性推理、不确定性推理 若按推理时所用知识的确定性来划分,推理可分为确定性推理与不确定性推理 所谓确定性推理是指推理时所用的知识与证据都是确定的,推...", chapter_title: "确定性推理方法", facets: [], quality_issues: [], entity_type: "method", source_line_no: 178, name: "推理的基本概念", source_path: "人工智能导论/第3章 确定性推理方法/3.1 推理的基本概念", review_status: "approved", node_id: "457596056b7243d0" },
