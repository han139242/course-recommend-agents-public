  { source_structure_id: "b567aa58b3503229", aliases: ["证据理论"], raw_name: "证据理论", canonical_name: "证据理论", confidence: 0.9, description: "证据理论(Theory of Evidence)由德普斯特(A.P.Dempster)于20世纪60年代首先提出,并由沙佛(G.Shafer)在20世纪70年代中期进一步发展起来的一种处理不确定性的理论,所以,又称为D-S理论。1981年巴纳特(J.A.Barnett)把该理论引入专家系统中,同年卡威(J.Garvey)等人用它实现了不确定性推理。由于...", chapter_title: "不确定性推理方法", facets: [], quality_issues: [], entity_type: "method", source_line_no: 194, name: "证据理论", source_path: "人工智能导论/第4章 不确定性推理方法/4.3 证据理论", review_status: "approved", node_id: "cfb814d97bff0054" },
  { source_structure_id: "2fbf95dd85bccd59", aliases: ["随机神经网络"], raw_name: "随机神经网络", canonical_name: "随机神经网络", confidence: 0.95, description: "在Hopfield神经网络中,神经元状态为1是根据其输入是否大于阈值确定的,是确定性的。而在随机神经网络中,神经元状态为1是随机的,服从一定的概率分布。例如,服从玻耳兹曼(Boltzmann)、高斯(Gaussian)、柯西(Cauchy)分布等,从而构成玻耳兹曼机、高斯机、柯西机等随机机 下面主要以玻耳兹曼机为例,介绍随机神经网络 1985年,加拿大...", chapter_title: "人工神经网络及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 326, name: "随机神经网络", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.4 Hopfield神经网络及其改进/8.4.3 随机神经网络", review_status: "approved", node_id: "d00365a63156db2d" },
