  { source_structure_id: "9ef3ccb9bd1f4ed4", aliases: ["合同网协作方法"], raw_name: "合同网协作方法", canonical_name: "合同网协作方法", confidence: 0.95, description: "在所有的协作方法中,合同网(Contract Net)是最著名且应用最广泛的一种协作方法。它是由Smith于1980年提出的。基本思想来自人们在商务过程中用于管理商品和服务的合同机制。在合同网方法中,所有智能体分为两种角色:管理者(manager)和工作者(worker)。其中,管理者智能体的职责包括 1对每一待求解任务建立任务通知书(task ann...", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], entity_type: "method", source_line_no: 355, name: "合同网协作方法", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.5 多智能体系统的协作/9.5.2 合同网协作方法", review_status: "approved", node_id: "b86d6644f195ca9a" },
  { source_structure_id: "curated::F1值", aliases: ["F1值"], raw_name: "F1值", canonical_name: "F1值", confidence: 1, description: "精确率与召回率调和平均得到的分类综合评估指标。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 0, name: "F1值", source_path: "curated/batch_01_machine_learning_foundation", review_status: "approved", node_id: "b979e5a7ff3e9d94" },
  { source_structure_id: "f7d3c25eb5def9e7", aliases: ["概率分配函数"], raw_name: "概率分配函数", canonical_name: "概率分配函数", confidence: 0.95, description: "证据理论是用集合表示命题的 设D是变量x所有可能取值的集合,且D中的元素是互斥的,在任一时刻x都取且只能取D中的某一个元素为值,则称D为x的样本空间 在证据理论中,D的任何一个子集A都对应于一个关于x的命题,称该命题为“x的值是在A中”。例如,用x代表打靶时所击中的环数,D = \\{ 1 , 2 , \\cdots , 1 0 \\},则A = \\{ 5 ...", chapter_title: "不确定性推理方法", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 195, name: "概率分配函数", source_path: "人工智能导论/第4章 不确定性推理方法/4.3 证据理论/4.3.1 概率分配函数", review_status: "approved", node_id: "b9badb2421e06a46" },
  { source_structure_id: "curated::音视频联合建模", aliases: ["音视频联合建模"], raw_name: "音视频联合建模", canonical_name: "音视频联合建模", confidence: 1, description: "联合利用声音与视觉线索进行表示学习和任务建模的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], source_line_no: 0, entity_type: "method", name: "音视频联合建模", source_path: "curated/batch_20_multimodal_learning_foundation", review_status: "approved", node_id: "ba1246d75d24f4b7" },
  { source_structure_id: "cf9639624d4e4bb8", aliases: ["Hopfield神经网络在联想记忆中", "Hopfield神经网络在联想记忆中的应用"], raw_name: "Hopfield神经网络在联想记忆中的应用", canonical_name: "Hopfield神经网络在联想记忆中", confidence: 0.95, description: "如果将网络的一个稳态作为一个记忆样本,那么以后当给这个网络一个适当的激励时,网络能够收敛到和输入模式最为相似的样本模式。初态朝稳态的收敛过程便是寻找记忆样本的过程。初态可以认为是给定样本的部分信息,网络改变的过程可以认为是从部分信息找到全部信息,从而实现了联想记忆的功能 Hopfield 神经网络联想记忆过程,就是非线性动力学系统朝某个稳定状态运行的过...", chapter_title: "人工神经网络及其应用", facets: ["应用"], quality_issues: ["facet_merged"], entity_type: "algorithm", source_line_no: 6755, name: "Hopfield神经网络在联想记忆中", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.5 Hopfield神经网络的应用/8.5.1 Hopfield神经网络在联想记忆中的应用", review_status: "approved", node_id: "ba6debf1d783858d" },
