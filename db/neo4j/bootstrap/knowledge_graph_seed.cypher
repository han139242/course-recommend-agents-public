  { source_structure_id: "c224203c9ad51a3a", aliases: ["举例说明蚁群算法的搜索原理,并简要叙述蚁群算法", "举例说明蚁群算法的搜索原理,并简要叙述蚁群算法的特点"], raw_name: "举例说明蚁群算法的搜索原理,并简要叙述蚁群算法的特点", canonical_name: "举例说明蚁群算法的搜索原理,并简要叙述蚁群算法", confidence: 0.9, description: "习题 习题 167 .表6.6 适应度表 个体编号 原适应度 调整后的适应度 原选择概率 调整后的选择概率", chapter_title: "人工智能在游戏设计中的应用", facets: ["特点"], quality_issues: ["facet_merged"], entity_type: "algorithm", source_line_no: 5290, name: "举例说明蚁群算法的搜索原理,并简要叙述蚁群算法", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/6.15 举例说明蚁群算法的搜索原理,并简要叙述蚁群算法的特点", review_status: "approved", node_id: "6e3bc1f86e2aedd4" },
  { source_structure_id: "4510564e7dedcdcb", aliases: ["交叉", "基本遗传算法交叉"], raw_name: "交叉", canonical_name: "基本遗传算法交叉", confidence: 0.95, description: "当两个生物机体配对或者复制时,它们的染色体相互混合,产生一个由双方基因组成的全新的染色体组。这一过程称为重组(recombination)或者交叉(crossover) 交叉得到的后代可能继承了上代的优良基因,其后代会比它们的父母更加优秀,但也可能继承了上代的不良基因,其后代则会比它们的父母差,难以生存,甚至不能再复制自己。越能适应环境的后代越能继续复...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], source_line_no: 245, entity_type: "algorithm", name: "基本遗传算法交叉", source_path: "人工智能导论/第6章 智能计算及其应用/6.2 基本遗传算法/6.2.7 交叉", review_status: "approved", node_id: "6ec7ca4cc7a67e01" },
