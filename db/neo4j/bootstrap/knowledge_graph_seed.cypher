  { source_structure_id: "2058698217f62e25", aliases: ["专家系统的建立"], raw_name: "专家系统的建立", canonical_name: "专家系统的建立", confidence: 0.9, description: "专家系统是人工智能中一个正在发展的研究领域,虽然目前已建立了许多专家系统,但是尚未形成建立专家系统的一般方法。下面简单介绍专家系统的一般建立过程 专家系统是一个计算机软件系统,但与传统程序又有区别,因为知识工程与软件工程在许多方面有较大的差别,所以专家系统的开发过程在某些方面与软件工程类似,但某些方面又有区别。例如,软件工程的设计目标是建立一个用于事物...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "application", source_line_no: 299, name: "专家系统的建立", source_path: "人工智能导论/第7章 专家系统与机器学习/7.7 专家系统的建立", review_status: "approved", node_id: "7ba98446cf060bea" },
  { source_structure_id: "curated::混合检索", aliases: ["混合检索"], raw_name: "混合检索", canonical_name: "混合检索", confidence: 1, description: "结合关键词检索与向量检索结果提高覆盖率和相关性的检索方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "混合检索", source_path: "curated/batch_18_llm_app_rag_foundation", review_status: "approved", node_id: "7bc4d2a95e69829e" },
  { source_structure_id: "db96d56d6b502833", aliases: ["综合数据库"], raw_name: "综合数据库", canonical_name: "综合数据库", confidence: 0.95, description: "综合数据库(Global Database)又称动态数据库或黑板,主要用于存放初始事实、问题描述及系统运行过程中得到的中间结果、最终结果等信息 在开始求解问题时,综合数据库中存放的是用户提供的初始事实。综合数据库的内容随着推理过程的进行而变化,推理机会根据综合数据库的内容从知识库中选择合适的知识进行推理并将得到的中间结果存放于综合数据库中。综合数据库中...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 280, name: "综合数据库", source_path: "人工智能导论/第7章 专家系统与机器学习/7.3 专家系统的工作原理/7.3.4 综合数据库", review_status: "approved", node_id: "7be2b5b762a76dcb" },
  { source_structure_id: "31851eeba46fdc00", aliases: ["医学专家系统-MYCIN"], raw_name: "医学专家系统-MYCIN", canonical_name: "医学专家系统-MYCIN", confidence: 0.95, description: "MYCIN系统是由斯坦福大学1972年开始研制的用于对细菌感染性疾病进行诊断和治疗的专家系统。MYCIN的功能是帮助内科医生诊断细菌感染疾病,并给出建议性的诊断结果和处方。MYCIN系统是将产生式规则从通用问题求解的研究转移到解决专门问题的一个成功的典范,在专家系统的发展中占有重要的地位,许多专家系统就是在它的基础上建立起来的 1.MYCIN系统总体结...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "application", source_line_no: 301, name: "医学专家系统-MYCIN", source_path: "人工智能导论/第7章 专家系统与机器学习/7.8 专家系统实例/7.8.1 医学专家系统-MYCIN", review_status: "approved", node_id: "7beac8af2482f3bc" },
