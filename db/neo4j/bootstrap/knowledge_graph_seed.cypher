  { source_structure_id: "301a158592bec1b4", aliases: ["人工智能游戏"], raw_name: "人工智能游戏", canonical_name: "人工智能游戏", confidence: 0.9, description: "继2013年《Playing Atari with Deep Reinforcement Learning》发表以后,Google DeepMind的alphaGo在围棋上的AI突破又一次震惊了世界!其实,从1950年香农教授提出为计算机象棋博弈编写程序开始,游戏人工智能就是人工智能技术研究的前沿,被誉为人工智能界的“果蝇”,推动着人工智能技术的发展 ...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 375, name: "人工智能游戏", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.1 人工智能游戏", review_status: "approved", node_id: "5d6895b3b2b5e17c" },
