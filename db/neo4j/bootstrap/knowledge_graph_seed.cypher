  { source_structure_id: "a4efbdff82d566a0", aliases: ["BP神经网络在模式识别中", "BP神经网络在模式识别中的应用"], raw_name: "BP神经网络在模式识别中的应用", canonical_name: "BP神经网络在模式识别中", confidence: 0.95, description: "模式识别主要研究用计算机模拟生物、人的感知,对模式信息(如图像、文字、语音等)进行识别和分类。传统人工智能的研究部分地显示了人脑的归纳、推理等智能。但是,对于人类底层的智能,如视觉、听觉、触觉等方面,现代计算机系统的信息处理能力还不如一个幼儿园的孩子 神经网络模型模拟了人脑神经系统的特点:处理单元的广泛连接,并行分布式信息储存、处理,自适应学习能力等。...", chapter_title: "人工神经网络及其应用", facets: ["应用"], quality_issues: ["facet_merged"], entity_type: "algorithm", source_line_no: 321, name: "BP神经网络在模式识别中", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.3 BP神经网络的应用/8.3.1 BP神经网络在模式识别中的应用", review_status: "approved", node_id: "5c17a15362f29aa0" },
