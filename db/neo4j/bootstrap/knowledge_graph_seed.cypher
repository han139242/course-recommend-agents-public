  { source_structure_id: "2bed3b847ffff989", aliases: ["知识发现的对象"], raw_name: "知识发现的对象", canonical_name: "知识发现的对象", confidence: 0.95, description: "1.数据库 数据库是当然的知识发现对象。当前研究比较多的是关系数据库的知识发现。其主要研究课题有超大数据量、动态数据、噪声、数据不完整性、冗余信息和数据稀疏等 2.数据仓库 随着计算机技术的迅猛发展,到20世纪80年代,许多企业的数据库中积累了大量的数据。于是,便产生了进一步使用这些数据的需求,就是想通过对这些数据的分析和推理,为决策提供依据。但对于这...", chapter_title: "专家系统与机器学习", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 298, name: "知识发现的对象", source_path: "人工智能导论/第7章 专家系统与机器学习/7.6 知识发现与数据挖掘/7.6.5 知识发现的对象", review_status: "approved", node_id: "32f9f2acf7a34d28" },
