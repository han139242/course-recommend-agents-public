  { source_structure_id: "curated::数据划分一致性", aliases: ["数据划分一致性"], raw_name: "数据划分一致性", canonical_name: "数据划分一致性", confidence: 1, description: "训练、验证与测试集划分在时序、用户或域上的一致规则，以避免信息泄漏与乐观偏差。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], source_line_no: 0, entity_type: "concept", name: "数据划分一致性", source_path: "curated/batch_25_ai_evaluation_benchmark_experiment_design", review_status: "approved", node_id: "8fddafb84ff02ba5" },
  { source_structure_id: "curated::CLIP", aliases: ["CLIP"], raw_name: "CLIP", canonical_name: "CLIP", confidence: 1, description: "通过图文对比学习实现视觉与语言统一表示的经典多模态模型。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 0, name: "CLIP", source_path: "curated/batch_20_multimodal_learning_foundation", review_status: "approved", node_id: "908c6f3d6d922abd" },
  { source_structure_id: "curated::鲁棒性", aliases: ["鲁棒性"], raw_name: "鲁棒性", canonical_name: "鲁棒性", confidence: 1, description: "模型在输入扰动、噪声或分布变化下维持稳定性能的能力。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 0, name: "鲁棒性", source_path: "curated/batch_13_ai_safety_ethics_governance", review_status: "approved", node_id: "908f8afd597a54d7" },
  { source_structure_id: "a16f7f7637d26f93", aliases: ["游戏角色的追逐与躲避"], raw_name: "游戏角色的追逐与躲避", canonical_name: "游戏角色的追逐与躲避", confidence: 0.95, description: "在游戏中,追逐与躲避是角色最普遍的行为。它与随机移动一起构成了早期游戏中主要使用的运动模式 1.随机移动 随机移动能够产生角色漫无目的徘徊的感觉。对于自由运动的角色,可以不断地产生随机的速度向量;对于靠转向力来改变速度方向的角色,可以不断产生随机的转向力。若使用完全的随机数来控制角色的移动,行动看起来不稳定,所以应该保持随机过程的一致性,可采用噪声函数...", chapter_title: "人工智能在游戏设计中的应用", facets: [], quality_issues: [], entity_type: "application", source_line_no: 382, name: "游戏角色的追逐与躲避", source_path: "人工智能导论/第11章 人工智能在游戏设计中的应用/11.4 智能游戏角色设计基本技术/11.4.2 游戏角色的追逐与躲避", review_status: "approved", node_id: "909e5218bfec1c09" },
  { source_structure_id: "curated::联邦平均算法", aliases: ["联邦平均算法"], raw_name: "联邦平均算法", canonical_name: "联邦平均算法", confidence: 1, description: "通过聚合各客户端本地模型参数更新实现全局模型训练的经典联邦算法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 0, name: "联邦平均算法", source_path: "curated/batch_21_federated_learning_privacy_computing", review_status: "approved", node_id: "90d667f94b188513" },
