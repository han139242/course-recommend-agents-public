  { source_structure_id: "471184539db1d170", aliases: ["不确定性推理", "不确定性推理的概念"], raw_name: "不确定性推理的概念", canonical_name: "不确定性推理", confidence: 0.9, description: "不确定性推理是从不确定性的初始证据出发,通过运用不确定性的知识,最终推出具有一定程度的不确定性但却是合理或者近乎合理的结论的思维过程 在不确定性推理中,知识和证据都具有某种程度的不确定性,这就为推理机的设计与实现增加了复杂性和难度。它除了必须解决推理方向、推理方法、控制策略等基本问题外,一般还需要解决不确定性的表示与度量、不确定性匹配、不确定性的传递算...", chapter_title: "不确定性推理方法", facets: ["概念"], quality_issues: ["facet_merged"], entity_type: "method", source_line_no: 192, name: "不确定性推理", source_path: "人工智能导论/第4章 不确定性推理方法/4.1 不确定性推理的概念", review_status: "approved", node_id: "dba317f6373711f8" },
  { source_structure_id: "e15106eefd9dc53f", aliases: ["智能体通信的类型"], raw_name: "智能体通信的类型", canonical_name: "智能体通信的类型", confidence: 0.95, description: "通常Agent采用两种方式进行通信:一是分享一个共同内部表示语言的Agent,它们无需任何外部语言就能通信;二是无需做出内部语言假设的Agent,它们共享英语子集作为通信语言 1.使用Tell和Ask通信 这种通信形式的Agent分享共同内部表示语言,并通过界面Tell和Ask直接访问共享的知", chapter_title: "智能体与多智能体系统", facets: [], quality_issues: [], source_line_no: 349, entity_type: "topic", name: "智能体通信的类型", source_path: "人工智能导论/第9章 智能体与多智能体系统/9.3 多智能体系统的通信/9.3.1 智能体通信的类型", review_status: "approved", node_id: "dbcf516964500b5c" },
