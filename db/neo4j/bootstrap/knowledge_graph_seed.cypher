  { source_structure_id: "3ac5580b3b7b449b", aliases: ["基本遗传算法编码", "编码"], raw_name: "编码", canonical_name: "基本遗传算法编码", confidence: 0.95, description: "遗传算法中包含了五个基本要素:参数编码,初始群体的设定,适应度函数的设计;遗传操作设计和控制参数设定 由于遗传算法不能直接处理问题空间的参数,因此,必须通过编码将要求解的问题表示成遗传空间的染色体或者个体。它们由基因按一定结构组成。由于遗传算法的健壮性,对编码的要求并不苛刻。对一个具体的应用问题如何编码是应用遗传算法的首要问题,也是遗传算法应用的难点。...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], source_line_no: 241, entity_type: "algorithm", name: "基本遗传算法编码", source_path: "人工智能导论/第6章 智能计算及其应用/6.2 基本遗传算法/6.2.3 编码", review_status: "approved", node_id: "f2a91cbe5758c653" },
