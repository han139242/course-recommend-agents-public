  { source_structure_id: "8579282d46d41abd", aliases: ["适应度函数"], raw_name: "适应度函数", canonical_name: "适应度函数", confidence: 0.95, description: "遗传算法遵循自然界优胜劣汰的原则,在进化搜索中基本上不用外部信息,而是用适应度值表示个体的优劣,作为遗传操作的依据。适应度是评价个体优劣的标准。个体的适应度高,则被选择的概率就高,反之就低。适应度函数(Fitness Function)是用来区分群体中的个体好坏的标准,是算法演化过程的驱动力,是进行自然选择的唯一依据。改变种群内部结构的操作都是通过适应...", chapter_title: "智能计算及其应用", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 243, name: "适应度函数", source_path: "人工智能导论/第6章 智能计算及其应用/6.2 基本遗传算法/6.2.5 适应度函数", review_status: "approved", node_id: "c579cb6c81fcb474" },
