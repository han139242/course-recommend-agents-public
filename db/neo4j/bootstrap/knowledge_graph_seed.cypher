  { source_structure_id: "1f6ee494a550d391", aliases: ["谓词公式化为子句集的方法"], raw_name: "谓词公式化为子句集的方法", canonical_name: "谓词公式化为子句集的方法", confidence: 0.9, description: "求证:小王喜欢ds这门课程 证明 首先定义谓词 E A S Y ( x ) ::x是容易的; L I K E ( x , y ):x喜欢y; C ( x ) :x是C班的一门课程 把上述已知事实及待求证的问题用谓词公式表示出来 ( \\forall x ) ( E A S Y ( x ) \\rightarrow L I K E ( W a n g , x...", chapter_title: "确定性推理方法", facets: [], quality_issues: [], entity_type: "method", source_line_no: 184, name: "谓词公式化为子句集的方法", source_path: "人工智能导论/第3章 确定性推理方法/3.3 谓词公式化为子句集的方法", review_status: "approved", node_id: "553f5a749864e531" },
  { source_structure_id: "curated::视频理解", aliases: ["视频理解"], raw_name: "视频理解", canonical_name: "视频理解", confidence: 1, description: "对视频中的时空事件、动作和语义内容进行建模与理解的任务。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "application", source_line_no: 0, name: "视频理解", source_path: "curated/batch_20_multimodal_learning_foundation", review_status: "approved", node_id: "556215e0696c1f09" },
  { source_structure_id: "curated::案例保存", aliases: ["案例保存"], raw_name: "案例保存", canonical_name: "案例保存", confidence: 1, description: "将新问题及其有效解答存入案例库以支持后续复用的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "案例保存", source_path: "curated/batch_05_expert_systems_knowledge_engineering", review_status: "approved", node_id: "556f324cfb1965e5" },
  { source_structure_id: "419e2dd3ca588c53", aliases: ["语音识别", "语音识别的概念"], raw_name: "语音识别", canonical_name: "语音识别", confidence: 0.95, description: "3.语音信号的特征参数提取 人说话的频率在10kHz以下。根据香农采样定理,为了使语音信号的采样数据中包含所需单词的信息,计算机的采样频率应是需要记录的语音信号中包含的最高语音频率的两倍以上。一般将信号分割成若干块,信号的每个块称为帧。为了保证可能落在帧边缘的重要信息不会丢失,应该使帧有重叠。例如,当使用20kHz的采样频率时,标准的一帧为10 ms,...", chapter_title: "自然语言处理及其应用", facets: ["概念"], quality_issues: ["facet_merged"], entity_type: "application", source_line_no: 367, name: "语音识别", source_path: "人工智能导论/第10章 自然语言处理及其应用/10.4 语音识别", review_status: "approved", node_id: "55811a7af565f242" },
  { source_structure_id: "curated::博弈搜索", aliases: ["博弈搜索"], raw_name: "博弈搜索", canonical_name: "博弈搜索", confidence: 1, description: "在对抗环境中基于博弈树进行决策求解的方法。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "method", source_line_no: 0, name: "博弈搜索", source_path: "curated/curated_ai_professional_ontology", review_status: "approved", node_id: "55ab07f0c9339f4a" },
  { source_structure_id: "curated::图文匹配", aliases: ["图文匹配"], raw_name: "图文匹配", canonical_name: "图文匹配", confidence: 1, description: "判断图像与文本描述是否语义一致的多模态任务。", chapter_title: "人工智能基础知识骨架", facets: [], quality_issues: [], entity_type: "application", source_line_no: 0, name: "图文匹配", source_path: "curated/batch_20_multimodal_learning_foundation", review_status: "approved", node_id: "565bdc6e3d42ba52" },
  { source_structure_id: "1978ece37c1b769e", aliases: ["机器翻译方法概述"], raw_name: "机器翻译方法概述", canonical_name: "机器翻译方法概述", confidence: 0.95, description: "人类对机器翻译(Machine Translation,MT)系统的研究开发已经持续了50多年。起初,机器翻译系统主要是基于双语字典进行直接翻译,几乎没有句法结构分析。直到20世纪80年代,一些机器翻译系统采用了间接方法。在这些方法中,源语言文本被分析转换成抽象表达形式,随后利用一些程序,通过识别词结构(词法分析)和句子结构(句法分析)解决歧义问题。其...", chapter_title: "自然语言处理及其应用", facets: [], quality_issues: [], entity_type: "method", source_line_no: 365, name: "机器翻译方法概述", source_path: "人工智能导论/第10章 自然语言处理及其应用/10.3 机器翻译/10.3.1 机器翻译方法概述", review_status: "approved", node_id: "5660e9b580775a20" },
