  { source_structure_id: "b6f4a8f62e41bc92", aliases: ["神经网络的学习"], raw_name: "神经网络的学习", canonical_name: "神经网络的学习", confidence: 0.95, description: "神经网络方法是一种知识表示方法和推理方法。神经网络知识表示方法与谓词、产生式、框架、语义网络等完全不同。谓词、产生式、框架、语义网络等方法是知识的显式表示。例如,在产生式系统中知识独立地表示为一条规则。神经网络知识表示是一种隐式的表示方法。在这里,将某一问题的若干知识通过学习表示在同一网络中 神经网络的学习是指调整神经网络的连接权值或者结构,使输入输出...", chapter_title: "人工神经网络及其应用", facets: [], quality_issues: [], entity_type: "algorithm", source_line_no: 315, name: "神经网络的学习", source_path: "人工智能导论/第8章 人工神经网络及其应用/8.1 神经元与神经网络/8.1.4 神经网络的学习", review_status: "approved", node_id: "111cb83483e9d880" },
