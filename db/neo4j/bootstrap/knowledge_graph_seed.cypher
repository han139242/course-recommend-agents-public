  { source_structure_id: "19ddcc563fc2b5d3", aliases: ["模糊集合的运算"], raw_name: "模糊集合的运算", canonical_name: "模糊集合的运算", confidence: 0.95, description: "模糊集合是经典集合的推广,所以,经典集合的运算可以推广到模糊集合。但由于模糊集合要由它的隶属函数加以确定,所以,需要重新定义模糊集合的基本运算 (1)模糊集合的包含关系 若\\mu _ { A } ( x ) \\geq \\mu _ { B } ( x ),则称A包含B,记作A \\supseteq B (2)模糊集合的相等关系 若\\mu _ { A } (...", chapter_title: "不确定性推理方法", facets: [], quality_issues: [], entity_type: "concept", source_line_no: 206, name: "模糊集合的运算", source_path: "人工智能导论/第4章 不确定性推理方法/4.4 模糊推理方法/4.4.3 模糊集合的运算", review_status: "approved", node_id: "e9ec684fae639e99" },
